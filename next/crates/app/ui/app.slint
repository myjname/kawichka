import {
    Button, CheckBox, ComboBox, LineEdit, TextEdit, SpinBox, ScrollView, Palette, AboutSlint
}
from "std-widgets.slint";
export {
    PetWindow, NoticeWindow, AppTray
}
from "companion.slint";
component CompactEdit inherits LineEdit {
    min-width: 0px;
    min-height: 34px;
    preferred-height: 34px;
    vertical-stretch: 0;
}
component CompactSpinBox inherits SpinBox {
    min-width: 0px;
    min-height: 34px;
    preferred-height: 34px;
    vertical-stretch: 0;
}
component CompactComboBox inherits ComboBox {
    min-width: 0px;
    min-height: 34px;
    preferred-height: 34px;
    vertical-stretch: 0;
}
component ActionButton inherits Button {
    height: 32px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    max-width: 250px;
}
component ChoiceToggle inherits CheckBox {
    height: 28px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
}
// All independent boolean settings share Field's value column.
component Hint inherits Text {
    min-width:0px;
    color: Colors.muted;
    font-size: 12px;
    wrap: word-wrap;
    vertical-stretch: 0;
}
component Toggle inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <length> label-width: 172px;
    callback toggled;
    property <length> control-height:max(34px, caption.preferred-height + 4px);
    height: root.control-height + (root.hint=="" ? 0px : detail.preferred-height+5px);
    vertical-stretch: 0;
    caption := Text {
        x:0px; y:0px;
        width: root.label-width - 8px; height: root.control-height;
        text: root.text; wrap: word-wrap; vertical-alignment: center;
        color: root.enabled ? Colors.ink : Colors.muted; font-size: 13px;
    }
    TouchArea {
        x:0px; y:0px;
        width: root.label-width - 8px; height: root.control-height; enabled:root.enabled;
        clicked => { control.focus(); root.checked = !root.checked; root.toggled(); }
    }
    control := CheckBox {
        x: root.label-width; y:0px; width: 32px; height: root.control-height;
        enabled: root.enabled; checked <=> root.checked;
        accessible-label: root.text;
        toggled => { control.focus(); root.toggled(); }
    }
    detail := Hint {
        x:root.label-width; y:root.control-height+3px;
        width:max(0px,min(600px,parent.width - root.label-width));
        visible:root.hint!=""; text:root.hint;
    }
}
component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    width:max(100px, label.preferred-width + 24px); height:36px;
    horizontal-stretch:0; vertical-stretch:0;
    background:root.selected ? Colors.soft : transparent;
    accessible-role: tab; accessible-label:root.text;
    accessible-checkable:true; accessible-checked:root.selected;
    accessible-action-default=>{root.clicked();}
    label := Text { text:root.text; horizontal-alignment:center; vertical-alignment:center; color:root.selected ? Colors.accent : Colors.muted; }
    Rectangle { y:parent.height - 2px; height:2px; width:parent.width; background:root.selected ? Colors.accent : transparent; }
    focus := FocusScope {
        key-pressed(event)=>{ if(event.text==" " || event.text=="\n"){ root.clicked(); return accept; } return reject; }
    }
    TouchArea { clicked=>{ focus.focus(); root.clicked(); } }
}
export struct LibraryItem {
    identifier:string, text:string, caption:string, kept:bool, excluded:bool, has-audio:bool, state:string, state-hint:string, selected:bool
}
component IconButton inherits Rectangle {
    in property <string> tip;
    in property <image> icon;
    in property <bool> enabled:true;
    callback clicked;
    width:30px; height:30px; horizontal-stretch:0; vertical-stretch:0;
    border-width:1px; border-radius:4px;
    border-color:focus.has-focus ? Colors.accent : Colors.line;
    background:area.has-hover && root.enabled ? Colors.soft : Colors.surface;
    accessible-role:button; accessible-enabled:root.enabled;
    accessible-label:root.tip;
    accessible-action-default=>{ if(root.enabled){root.clicked();} }
    Image { x:6px; y:6px; width:18px; height:18px; source:root.icon; colorize:Colors.ink; opacity:root.enabled ? 1 : 0.4; }
    focus := FocusScope {
        enabled:root.enabled;
        key-pressed(event)=>{ if(event.text==" " || event.text=="\n"){root.clicked();return accept;}return reject; }
    }
    area := TouchArea { clicked=>{ if(root.enabled){focus.focus();root.clicked();} } }
    Tooltip { text:@markdown("\{root.tip}"); }
}
export struct PendingItem {
    identifier:string, text:string, caption:string
}
export component RemovalWindow inherits Window {
    title:root.english ? "Kavychka · removal" : "Кавычка · удаление";
    preferred-width:760px;
    preferred-height:620px;
    min-width:660px;
    min-height:520px;
    in property <bool> english;
    in property <bool> dark;
    in property <bool> busy;
    in property <bool> removing;
    in property <bool> reviewed;
    in property <bool> done;
    in property <string> summary;
    in-out property <bool> full;
    in-out property <bool> confirmed;
    callback preview;
    callback remove;
    callback dismiss;
    background:Colors.canvas;
    init=>{
        Colors.dark=root.dark;
        Palette.color-scheme=root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    VerticalLayout {
        padding:28px;
        spacing:16px;
        Text {
            text:root.english ? "Remove Kavychka" : "Удаление Кавычки";
            font-size:24px;
            font-weight:600;
            color:Colors.ink;
        }
        Toggle {
            text:root.english ? "Also remove ALL data and models" : "Удалить также ВСЕ данные и модели";
            checked <=> root.full;
            enabled:!root.busy && !root.done;
            toggled=>{
                root.confirmed=false;
                root.preview();
            }
        }
        TextEdit {
            text:root.summary;
            read-only:true;
            vertical-stretch:1;
            accessible-label:root.english ? "Removal contents" : "Точный состав удаления";
        }
        ChoiceToggle {
            text:root.english ? "I reviewed and confirm removal" : "Я проверил состав и подтверждаю удаление";
            checked <=> root.confirmed;
            enabled:root.reviewed && !root.busy && !root.done;
        }
        HorizontalLayout {
            spacing:8px;
            Button{
                text:root.english ? "Review again" : "Проверить ещё раз";
                enabled:!root.busy && !root.done;
                clicked=>{
                    root.confirmed=false;
                    root.preview();
                }
            }
            Rectangle{
                horizontal-stretch:1;
            }
            Button{
                text:root.english ? "Remove" : "Удалить";
                enabled:root.reviewed && root.confirmed && !root.busy && !root.done;
                clicked=>{
                    root.remove();
                }
            }
            Button{
                text:root.done ? (root.english ? "Close" : "Закрыть") : (root.english ? "Cancel" : "Отмена");
                enabled:!root.busy || !root.removing;
                clicked=>{
                    root.dismiss();
                }
            }
        }
    }
}
export component TransferWindow inherits Window {
    title: "Кавычка · перенос хранилища / Kavychka storage transfer";
    preferred-width: 720px;
    preferred-height: 440px;
    min-width: 600px;
    min-height: 380px;
    in property <bool> dark;
    in property <bool> done;
    in property <string> destination;
    in property <string> status;
    callback cancel;
    callback resume;
    background: Colors.canvas;
    init => {
        Colors.dark=root.dark;
        Palette.color-scheme=root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Colors.dark=root.dark;
        Palette.color-scheme=root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    VerticalLayout {
        padding:28px;
        spacing:16px;
        Text {
            text:"Перенос общей папки / Moving shared storage";
            font-size:23px;
            font-weight:600;
            color:Colors.ink;
            wrap:word-wrap;
        }
        Text {
            text:"Данные, модели и среды копируются без скачивания. Исходная папка сохраняется. При отмене продолжим с прежними данными. / Data, models and runtimes are copied without downloads. Source retained; cancellation keeps the previous data active.";
            color:Colors.muted;
            wrap:word-wrap;
        }
        CompactEdit {
            text:root.destination;
            read-only:true;
            accessible-label:"Папка назначения / Destination";
        }
        TextEdit {
            text:root.status;
            read-only:true;
            accessible-label:"Ход переноса / Transfer progress";
            vertical-stretch:1;
        }
        HorizontalLayout {
            Rectangle {
                horizontal-stretch:1;
            }
            ActionButton {
                text:"Отменить / Cancel";
                enabled:!root.done;
                clicked=>{
                    root.cancel();
                }
            }
            ActionButton {
                text:"Открыть Кавычку / Open Kavychka";
                enabled:root.done;
                primary:true;
                clicked=>{
                    root.resume();
                }
            }
        }
    }
}
export component SetupWindow inherits Window {
    title: "Кавычка · установка / Kavychka setup";
    preferred-width: 720px;
    preferred-height: 590px;
    min-width: 660px;
    min-height: 540px;
    in-out property <length> scroll-y;
    out property <length> scroll-overflow: max(0px, setup-scroll.content-height - setup-scroll.height);
    in-out property <bool> advanced;
    in property <bool> dark;
    in property <string> version;
    in-out property <string> program-path;
    in-out property <string> data-path;
    in-out property <string> legacy-path;
    in-out property <bool> integrations: true;
    in property <bool> portable;
    in-out property <bool> busy;
    in-out property <bool> done;
    in-out property <int> recovery-limit-mb: 2000;
    in-out property <bool> budget-edited;
    in-out property <string> status;
    callback install;
    callback open;
    init => {
        Colors.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Colors.dark = root.dark;
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    background: Colors.canvas;
    VerticalLayout {
        padding: 22px;
        spacing: 10px;
        Text {
            text: "Кавычка / Kavychka " + root.version;
            font-size: 26px;
            font-weight: 600;
            color: Colors.ink;
        }
        Text {
            text: "Установка для текущего пользователя / Install for the current user";
            color: Colors.muted;
        }
        setup-scroll := ScrollView {
            content-y <=> root.scroll-y;
            content-width: self.width;
            VerticalLayout {
                spacing: 12px;
                padding-right: 12px;
                Text {
                    text: "Программа / Program";
                    color: Colors.ink;
                }
                CompactEdit {
                    preferred-height:34px;
                    vertical-stretch:0;
                    enabled: !root.busy && !root.done && !root.portable;
                    text <=> root.program-path;
                }
                Text {
                    text: "Папка моделей и данных / Models and data folder";
                    color: Colors.ink;
                }
                CompactEdit {
                    preferred-height:34px;
                    vertical-stretch:0;
                    enabled: !root.busy && !root.done && !root.portable;
                    text <=> root.data-path;
                }
                ChoiceToggle {
                    text: "Дополнительно / Advanced";
                    checked <=> root.advanced;
                    enabled: !root.busy && !root.done;
                }
                if root.advanced : VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: "Прежняя библиотека · необязательно / Previous library · optional";
                        color: Colors.ink;
                    }
                    CompactEdit {
                        preferred-height:34px;
                        vertical-stretch:0;
                        enabled: !root.busy && !root.done && !root.portable;
                        text <=> root.legacy-path;
                    }
                    Text {
                        text: "Лимит резервов и карантина · МБ / Recovery budget · MB";
                        color: Colors.ink;
                    }
                    CompactSpinBox {
                        preferred-height:34px;
                        max-width:160px;
                        vertical-stretch:0;
                        enabled: !root.busy && !root.done;
                        minimum: 100;
                        maximum: 100000;
                        value <=> root.recovery-limit-mb;
                        edited => {
                            root.budget-edited=true;
                        }
                    }
                }
                Text {
                    height: 85px;
                    wrap: word-wrap;
                    color: Colors.muted;
                    text: "Модели и записи сохраняются отдельно от версии приложения. Закрой работающую Кавычку перед установкой. Базовый режим работает без Python и загрузки моделей.\nModels and recordings are separate from app versions. Close Kavychka before installing. Basic reminders need no Python or model downloads.";
                }
                Toggle {
                    enabled: !root.busy && !root.done && !root.portable;
                    text: "Ярлык в меню Пуск / Start menu shortcut";
                    checked <=> root.integrations;
                }
            }
        }
        Text {
            height: 54px;
            text: root.status;
            wrap: word-wrap;
            color: Colors.ink;
        }
        HorizontalLayout {
            min-height:110px;
            AboutSlint {
                min-height:110px; preferred-height:110px;
                width: 180px;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            ActionButton {
                height: 36px;
                enabled: !root.busy && !root.done;
                text: root.busy ? "Устанавливаем… / Installing…" : "Установить / Install";
                primary: true;
                clicked => {
                    root.install();
                }
            }
            ActionButton {
                height: 36px;
                enabled: root.done;
                text: "Открыть / Open";
                clicked => {
                    root.open();
                }
            }
        }
    }
}
export global Colors {
    in property <bool> dark;
    out property <color> canvas: dark ? #15171d : #f5f6fa;
    out property <color> surface: dark ? #20232c : #ffffff;
    out property <color> soft: dark ? #282d3a : #edf0fc;
    out property <color> line: dark ? #333744 : #e7e9f0;
    out property <color> ink: dark ? #f1f2f6 : #242837;
    out property <color> muted: dark ? #b1b9ca : #596579;
    out property <color> accent: dark ? #a1b0ff : #4d60bd;
}
component SectionTitle inherits Text {
    color: Colors.ink;
    font-size: 15px;
    font-weight: 600;
    height: 24px;
    vertical-stretch: 0;
    vertical-alignment: center;
}

component Label inherits Text {
    color: Colors.ink;
    font-family: "Segoe UI";
    font-size: 14px;
    vertical-alignment: center;
    overflow: elide;
}
component Card inherits Rectangle {
    vertical-stretch: 0;
    background: Colors.surface;
    border-width: 1px;
    border-color: Colors.line;
    border-radius: 9px;
}
component Nav inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> compact;
    in property <bool> tight;
    in property <bool> enabled: true;
    callback clicked;
    height: root.tight ? 32px : 36px;
    border-radius: 10px;
    background: selected ? Colors.soft : transparent;
    border-color: focus.has-focus ? Colors.accent : transparent;
    border-width: 2px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    forward-focus: focus;
    Tooltip {
        text: @markdown("\{root.text}");
    }
    Image {
        x: 15px;
        y: (parent.height - 20px)/2;
        width: 20px;
        height: 20px;
        source: root.icon;
        colorize: root.selected ? Colors.accent : Colors.muted;
    }
    Label {
        visible: !root.compact;
        x: 48px;
        width: parent.width - 56px;
        height: parent.height;
        text: root.text;
        wrap: word-wrap;
        font-size: 13px;
        color: root.selected ? Colors.accent : Colors.muted;
        font-weight: root.selected ? 600 : 400;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == "\n" || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
}
component Field inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <length> label-width: 172px;
    in property <length> control-width: 330px;
    in property <length> control-min-height:34px;
    property <length> control-height:max(root.control-min-height,caption.preferred-height+4px);
    height: root.control-height + (root.hint == "" ? 0px : detail.preferred-height + 5px);
    vertical-stretch: 0;
    background: transparent;
    caption := Text {
        x: 0px;
        y: 0px;
        width: root.label-width - 8px;
        height: root.control-height;
        text: root.title;
        wrap: word-wrap;
        font-size: 13px;
        color:Colors.ink;
        vertical-alignment:center;
        min-width:0px;
    }
    Rectangle {
        x: root.label-width;
        y: (root.control-height - root.control-min-height)/2;
        width: max(0px,min(root.control-width,parent.width - root.label-width));
        height: root.control-min-height;
        HorizontalLayout {
            padding: 0px;
            @children
        }
    }
    detail := Hint {
        visible: root.hint != "";
        x: root.label-width; y: root.control-height+3px;
        width: max(0px, min(600px, parent.width - root.label-width));
        text: root.hint;
    }
}
component CloseDialog inherits Rectangle {
    in property <bool> english;
    in property <bool> background-close;
    callback cancel;
    callback discard;
    callback save;
    background: #00000070;
    TouchArea {
    }
    FocusScope {
        focus-on-tab-navigation: false;
        init => {
            keep.focus();
        }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                if (event.text == Key.Backtab || event.modifiers.shift) {
                    if (keep.has-focus) {
                        commit.focus();
                    }
                    else if (commit.has-focus) {
                        reject-changes.focus();
                    }
                    else {
                        keep.focus();
                    }
                }
                else {
                    if (keep.has-focus) {
                        reject-changes.focus();
                    }
                    else if (reject-changes.has-focus) {
                        commit.focus();
                    }
                    else {
                        keep.focus();
                    }
                }
                return accept;
            }
            return reject;
        }
        Card {
            x: (parent.width - self.width)/2;
            y: (parent.height - self.height)/2;
            width: min(600px,parent.width - 48px);
            height: 240px;
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Label {
                    height: 32px;
                    text: root.english ? "Save your changes?" : "Сохранить изменения?";
                    font-size: 22px;
                    font-weight: 600;
                }
                Label {
                    height: 60px;
                    wrap: word-wrap;
                    color: Colors.muted;
                    text: root.english ? "You have unsaved settings. Choose what to keep before closing." : "Остались несохранённые настройки. Выбери, что сохранить перед закрытием.";
                }
                HorizontalLayout {
                    height: 40px;
                    spacing: 10px;
                    keep := ActionButton {
                        text: root.english ? "Keep editing" : "Продолжить";
                        clicked => {
                            root.cancel();
                        }
                    }
                    reject-changes := ActionButton {
                        text: root.english ? "Discard" : "Не сохранять";
                        clicked => {
                            root.discard();
                        }
                    }
                    commit := ActionButton {
                        text: root.english ? "Save and close" : "Сохранить и закрыть";
                        primary: true;
                        clicked => {
                            root.save();
                        }
                    }
                }
            }
        }
    }
}
component RemovePhraseDialog inherits Rectangle {
    in property <bool> english;
    in property <int> count:1;
    callback cancel;
    callback confirm;
    background:#00000070;
    TouchArea { }
    FocusScope {
        init=>{ cancel-button.focus(); }
        key-pressed(event)=>{
            if(event.text==Key.Escape){root.cancel();return accept;}
            if(event.text==Key.Tab || event.text==Key.Backtab){
                if(cancel-button.has-focus){remove-button.focus();}else{cancel-button.focus();}
                return accept;
            }
            return reject;
        }
        Card {
            x:(parent.width - self.width)/2; y:(parent.height - self.height)/2;
            width:min(460px,parent.width - 48px); height:200px;
            VerticalLayout {
                padding:20px; spacing:12px;
                SectionTitle { text:root.english ? ("Remove selected: "+root.count+"?") : ("Удалить выделенные: "+root.count+"?"); }
                Hint { text:root.english ? "It will leave the list and reminders. Its text stays in anti-repeat history; the recording follows the daily audio cleanup policy." : "Фраза исчезнет из списка и напоминаний. Текст останется для защиты от повторов; запись — до обычной очистки аудио."; }
                HorizontalLayout {
                    spacing:8px; alignment:end; vertical-stretch:0;
                    cancel-button := ActionButton { text:root.english ? "Cancel" : "Отмена"; clicked=>{root.cancel();} }
                    remove-button := ActionButton { text:root.english ? "Remove" : "Удалить"; clicked=>{root.confirm();} }
                }
            }
        }
    }
}
export component AppWindow inherits Window {
    in property <[string]> support-texts;
    in-out property <int> support-index;
    in property <image> today-image;
    in property <bool> today-custom;
    in property <bool> today-pixelated;

    in property <string> task-title;
    in property <string> task-details;
    in property <float> task-progress: -1;
    in property <bool> task-error;
    in property <string> library-counts;
    in property <string> text-readiness;
    in property <string> voice-readiness;
    in property <[string]> text-readiness-list;
    in property <[string]> voice-readiness-list;
    in-out property <bool> show-task-details;
    in-out property <bool> library-controls;
    in-out property <string> expanded-phrase;
    in-out property <bool> character-options;
    in property <string> character-feedback;
    in-out property <bool> import-help;
    in-out property <bool> preset-import-options;
    in property <bool> preset-editing-visual;
    in property <string> preset-body-label: root.english ? "Character description" : "Описание характера";
    in-out property <bool> preset-management;
    in-out property <bool> delivery-editor;
    in-out property <bool> data-advanced;
    in-out property <bool> update-details;
    in-out property <bool> restore-onboarding;
    in-out property <bool> confirm-preset-import;
    in-out property <string> character-pack-name;
    in-out property <string> last-imported-preset;
    callback save-character-pack;
    callback import-character;
    in property <bool> data-operation-active;
    in property <bool> profile-running;
    in property <string> profile-review;
    in property <bool> profile-can-apply;
    in property <string> profile-status-ru;
    in property <string> profile-status-en;
    in property <string> profile-summary-ru;
    in property <string> profile-summary-en;
    in property <string> profile-output;
    in-out property <string> profile-export-path;
    in-out property <string> profile-import-path;
    in-out property <bool> profile-include-library:true;
    in-out property <bool> profile-include-audio:true;
    in-out property <int> profile-operation-index;
    callback profile-action(int);
    callback profile-browse(bool);
    in property <bool> transfer-available;
    in property <bool> transfer-busy;
    in property <bool> transfer-reviewed;
    in property <string> transfer-status;
    in-out property <string> transfer-target;
    callback transfer-estimate;
    callback transfer-apply;
    callback transfer-cancel;
    title: "Кавычка · Rust preview";
    preferred-width: 1100px;
    preferred-height: 780px;
    min-width: 720px;
    min-height: 540px;
    background: Colors.canvas;
    default-font-family: "Segoe UI";
    in property <bool> system-dark;
    in-out property <int> page;
    in-out property <length> scroll-y;
    out property <length> scroll-overflow: max(0px, main-scroll.content-height - main-scroll.height);
    changed page => {
        root.scroll-y = 0px;
    }
    in-out property <int> theme-index;
    in-out property <int> language-index;
    in-out property <int> speech-index;
    in-out property <string> user-name;
    in-out property <string> start-time;
    in-out property <string> end-time;
    in-out property <string> breakfast;
    in-out property <string> lunch;
    in-out property <string> dinner;
    in-out property <int> break-minutes;
    in-out property <int> stretch-minutes;
    in-out property <bool> meals;
    in-out property <bool> stretch;
    in-out property <bool> monday;
    in-out property <bool> tuesday;
    in-out property <bool> wednesday;
    in-out property <bool> thursday;
    in-out property <bool> friday;
    in-out property <bool> saturday;
    in-out property <bool> sunday;
    in-out property <int> idle-minutes;
    in-out property <int> allowed-clicks;
    in-out property <int> repeat-minutes;
    in-out property <bool> trust-confirmation;
    in-out property <int> break-repeats;
    in-out property <int> exercise-repeats;
    in-out property <int> meal-repeats;
    in-out property <int> audio-index;
    in-out property <int> fullscreen-visual-index;
    in-out property <int> fullscreen-audio-index;
    in-out property <bool> allow-during-dnd;
    in-out property <bool> pet-visible;
    in-out property <bool> animation;
    in-out property <int> animation-index: 1;
    in-out property <int> idle-play-seconds: 5;
    in-out property <int> idle-pause-seconds: 30;
    in-out property <int> address-index;
    in-out property <string> audio-device-id;
    in-out property <int> audio-device-index;
    in property <[string]> audio-device-names;
    in property <[string]> audio-device-ids;
    in-out property <string> audio-test-status;
    in-out property <bool> audio-refreshing;
    in-out property <bool> onboarding;
    in-out property <length> onboarding-scroll-y;
    in-out property <length> onboarding-scroll-overflow;
    in-out property <int> setup-step;
    callback setup-next(int);
    callback finish-setup(bool);
    callback refresh-audio;
    callback test-audio(int);
    property <bool> compact: root.width < 900px;
    property <bool> tight: root.height < 650px;
    property <length> nav-step: root.tight ? 32px : 36px;
    property <length> sidebar: root.compact ? 168px : 190px;
    property <length> content-x: root.sidebar + 20px;
    property <length> content-width: root.width - root.content-x - 20px;
    in property <[LibraryItem]> library-items;
    in property <[LibraryItem]> support-items;
    in-out property <string> library-selection;
    in-out property <string> library-day;
    in-out property <length> library-scroll-y;
    out property <length> library-scroll-overflow:max(0px,library-list.content-height - library-list.height);
    in property <int> library-selected-count;
    in property <bool> library-all-selected;
    callback toggle-library-item(string);
    callback select-all-library(bool);
    callback library-action(string);
    in-out property <bool> confirm-library-delete;
    in-out property <string> library-delete-selection;

    in property <string> library-json;
    in property <string> library-status;
    in property <string> library-summary;
    in property <bool> generation-running;
    in-out property <bool> library-today:true;
    in-out property <bool> library-support;
    in property <int> library-current-count;
    in property <int> library-history-count;
    in-out property <string> delete-phrase-id;
    callback hide-phrase(string);
    in property <int> library-page-index;
    in property <bool> library-has-next;
    in property <string> library-page-caption;
    callback library-page(int);
    in property <[PendingItem]> archived-notices;
    in property <int> archive-total;
    in property <int> archive-page-index;
    in property <bool> archive-has-next;
    callback archive-page(int);
    callback confirm-archived(string);
    in-out property <bool> confirm-clear;
    in property <[string]> text-catalog;
    in property <[string]> voice-catalog;
    in property <[string]> text-notes;
    in property <[string]> voice-notes;
    in-out property <int> text-model-index;
    in-out property <int> runtime-model-index;
    in-out property <int> voice-model-index;
    in-out property <bool> text-enabled;
    in-out property <bool> runtime-generation;
    in-out property <bool> auto-daily;
    in-out property <bool> auto-keep;
    in-out property <bool> generation-ac-only;
    in-out property <bool> swear;
    in-out property <int> batch-count;
    in-out property <bool> category-break;
    in-out property <bool> category-breakfast;
    in-out property <bool> category-lunch;
    in-out property <bool> category-dinner;
    in-out property <bool> category-exercise;
    in-out property <bool> model-advanced;
    in-out property <int> path-model-index;
    in-out property <string> path-model-value;
    in-out property <string> model-paths-json;
    in property <[string]> path-model-names;
    callback path-selected;
    callback path-edited;
    in-out property <int> runtime-seconds;
    in-out property <int> compute-device;
    in-out property <string> character-description;
    in property <[string]> character-names;
    in property <[string]> character-ids;
    in-out property <int> character-index;
    in property <[string]> visual-names;
    in property <[string]> visual-ids;
    in-out property <int> visual-index;
    in-out property <string> time-zone;
    in property <[string]> time-zone-names;
    in property <[string]> time-zone-ids;
    in-out property <int> time-zone-index;
    in-out property <int> pet-size: 130;
    in-out property <bool> generation-fullscreen: true;
    in-out property <bool> run-at-login;
    in-out property <bool> automatic-updates: true;
    in-out property <int> recovery-limit-mb: 2000;
    in property <[string]> preset-names;
    in property <[string]> preset-ids;
    in-out property <int> preset-index;
    in-out property <int> import-kind;
    in-out property <string> import-path;
    in-out property <string> import-transcript;
    in-out property <string> preset-name;
    in-out property <string> preset-body;
    in-out property <string> preset-json;
    in property <[string]> reference-names;
    in-out property <int> reference-index;
    in-out property <int> editing-reference;
    in-out property <int> visual-layout;
    in property <bool> preset-has-visual;
    in-out property <bool> confirm-preset-delete;
    in property <[string]> voice-profile-names;
    in property <[string]> voice-profile-ids;
    in-out property <int> voice-profile-index;
    in-out property <string> delivery-json;
    in property <[string]> delivery-names;
    in-out property <int> delivery-index;
    in-out property <string> delivery-name;
    in-out property <string> delivery-instruction;
    in-out property <string> custom-instruction;
    in property <string> loaded-prefs;
    in property <bool> background-running;
    in property <bool> on-battery;
    in property <string> runtime-status;
    in property <string> pending-text;
    in property <string> pending-key;
    in property <string> next-reminder;
    in property <string> pause-caption;
    in property <bool> breakfast-done;
    in property <bool> exercise-active;
    in-out property <int> pause-minutes-value: 15;
    in-out property <bool> close-to-background;
    in-out property <bool> dirty;
    in property <bool> ready;
    in property <bool> busy;
    in-out property <bool> failed;
    in-out property <string> status;
    in property <string> storage-path;
    in-out property <bool> confirm-close;
    changed confirm-close => {
        if (root.confirm-close) {
            unsaved-popup.show();
        }
        else {
            unsaved-popup.close();
        }
    }
    in-out property <bool> exit-after-save;
    out property <bool> english: language-index == 1;
    callback retranslate;
    changed english=>{root.retranslate();}
    callback save;
    callback discard;
    callback quit;
    callback save-and-quit;
    callback discard-and-quit;
    callback edited;
    callback runtime-update(string);
    callback runtime-stopped;
    callback confirm-reminder(string);
    callback stretch-now;
    callback cancel-stretch;
    callback mark-breakfast;
    callback pause-minutes(int);
    callback review-pending;
    callback silence;
    callback library-update(string);
    callback library-filter;
    callback prepare-day;
    callback generate-batch;
    callback generate-on-battery;
    callback regenerate-speech(string);
    callback select-phrase(string,bool);
    callback play-phrase(string);
    callback cancel-generation;
    callback export-library;
    callback install-models;
    callback repair-environment;
    callback refresh-library;
    callback clear-recordings;
    callback add-delivery;
    callback remove-delivery;
    callback character-selected;
    callback preset-selected;
    callback reference-selected;
    callback choose-preset-file;
    callback import-preset;
    callback save-preset;
    callback export-preset;
    callback delete-preset;
    in-out property <string> update-status;
    in-out property <string> update-notes;
    in-out property <bool> update-running;
    in-out property <bool> update-available;
    in-out property <bool> update-downloaded;
    in-out property <string> update-version;
    in-out property <bool> installed-version;
    in property <string> app-version;
    in-out property <bool> rollback-available;
    callback check-updates;
    callback download-update;
    callback cancel-update;
    callback apply-update;
    callback rollback-update;
    callback open-removal;
    in property <bool> removal-available;
    property <bool> effective-dark: theme-index == 2 || (theme-index == 0 && system-dark);
    function apply-theme() {
        Colors.dark = root.effective-dark;
        Palette.color-scheme = root.effective-dark ? ColorScheme.dark : ColorScheme.light;
    }
    init => {
        root.apply-theme();
    }
    changed effective-dark => {
        root.apply-theme();
    }
    edited => {
        root.dirty = true;
        root.status = "";
        root.failed = false;
    }
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.sidebar;
        height: parent.height;
        background: Colors.surface;
        Rectangle {
            x: parent.width - 1px;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: Colors.line;
        }
        Rectangle {
            x:16px;
            y:18px;
            width:30px;
            height:30px;
            background:#5369c9;
            border-radius:8px;
            Image {
                x:3px;
                y:3px;
                width:24px;
                height:24px;
                source:@image-url("../../design-preview/ui/quote.svg");
                colorize:white;
            }
        }
        Label {
            x:54px;
            y:18px;
            height:30px;
            width:parent.width - 62px;
            font-size:18px;
            font-weight:650;
            text:root.english ? "Kavychka" : "Кавычка";
        }
        Rectangle {
            x:8px;
            y:68px;
            width:parent.width - 16px;
            height:root.nav-step*8;
            background:transparent;
            Nav {
                y:root.nav-step*0;
                width:parent.width;
                tight:root.tight;
                compact:false;
                enabled:!root.confirm-close && !root.onboarding;
                text:root.english ? "Today" : "Сегодня";
                icon:@image-url("../../design-preview/ui/clock.svg");
                selected:root.page==0;
                clicked=>{
                    root.page=0;
                }
            }
            Nav {
                y:root.nav-step*1;
                width:parent.width;
                tight:root.tight;
                compact:false;
                enabled:!root.confirm-close && !root.onboarding;
                text:root.english ? "Schedule" : "Расписание";
                icon:@image-url("../../design-preview/ui/calendar.svg");
                selected:root.page==1;
                clicked=>{
                    root.page=1;
                }
            }
            Nav {
                y:root.nav-step*2;
                width:parent.width;
                tight:root.tight;
                compact:false;
                enabled:!root.confirm-close && !root.onboarding;
                text:root.english ? "Library" : "Библиотека";
                icon:@image-url("../../design-preview/ui/library.svg");
                selected:root.page==2;
                clicked=>{
                    root.page=2;
                    root.refresh-library();
                }
            }
            Nav {
                y:root.nav-step*3;
                width:parent.width;
                tight:root.tight;
                compact:false;
                enabled:!root.confirm-close && !root.onboarding;
                text:root.english ? "Voice and models" : "Голос и модели";
                icon:@image-url("../../design-preview/ui/voice.svg");
                selected:root.page==3;
                clicked=>{
                    root.page=3;
                    root.refresh-library();
                }
            }
            Nav {
                y:root.nav-step*4;
                width:parent.width;
                tight:root.tight;
                compact:false;
                enabled:!root.confirm-close && !root.onboarding;
                text:root.english ? "Character" : "Персонаж";
                icon:@image-url("../../design-preview/ui/person.svg");
                selected:root.page==4;
                clicked=>{
                    root.page=4;
                }
            }
            Nav {
                y:root.nav-step*5;
                width:parent.width;
                tight:root.tight;
                compact:false;
                enabled:!root.confirm-close && !root.onboarding;
                text:root.english ? "Settings" : "Настройки";
                icon:@image-url("../../design-preview/ui/settings.svg");
                selected:root.page==5;
                clicked=>{
                    root.page=5;
                }
            }
            Nav {
                y:root.nav-step*6;
                width:parent.width;
                tight:root.tight;
                compact:false;
                enabled:!root.confirm-close && !root.onboarding;
                text:root.tight ? (root.english ? "Data" : "Данные") : (root.english ? "Data and space" : "Данные и место");
                icon:@image-url("../../design-preview/ui/library.svg");
                selected:root.page==6;
                clicked=>{
                    root.page=6;
                }
            }
            Nav {
                y:root.nav-step*7;
                width:parent.width;
                tight:root.tight;
                compact:false;
                enabled:!root.confirm-close && !root.onboarding;
                text:root.english ? "Help" : "Помощь";
                icon:@image-url("../../design-preview/ui/settings.svg");
                selected:root.page==7;
                clicked=>{
                    root.page=7;
                }
            }
        }
        Rectangle {
            x:10px;
            y:parent.height - (root.tight ? 170px : 194px);
            width:parent.width - 20px;
            height:root.tight ? 116px : 140px;
            background:Colors.soft;
            border-radius:7px;
            VerticalLayout {
                padding:10px;
                spacing:5px;
                Label {
                    height:20px;
                    font-weight:600;
                    font-size:12px;
                    text:root.task-title != "" ? root.task-title : (root.english ? "Tasks" : "Задачи");
                }
                Label {
                    height:root.tight ? 36px : 54px;
                    wrap:word-wrap;
                    vertical-alignment:top;
                    font-size:11px;
                    color:root.task-error ? #d86660 : Colors.muted;
                    text:(root.generation-running && root.task-progress<0 ? (root.english ? "Working… " : "Выполняется… ") : "") + (root.library-status != "" ? root.library-status : (root.english ? "No tasks running" : "Нет активных задач"));
                }
                if root.generation-running && root.task-progress>=0 : Rectangle {
                    height:4px;
                    background:Colors.line;
                    border-radius:2px;
                    Rectangle {
                        height:parent.height;
                        width:parent.width*min(1,root.task-progress);
                        background:Colors.accent;
                        border-radius:2px;
                    }
                }
                HorizontalLayout {
                    spacing:4px;
                    if root.generation-running : ActionButton {
                        height:28px;
                        text:root.english ? "Cancel" : "Отмена";
                        clicked=>{
                            root.cancel-generation();
                        }
                    }
                    ActionButton {
                        height:28px;
                        text:root.english ? "Details" : (root.tight ? "Детали" : "Подробнее");
                        clicked=>{
                            root.show-task-details=!root.show-task-details;
                        }
                    }
                }
            }
        }
        ActionButton {
            x:12px;
            y:parent.height - 42px;
            width:parent.width - 24px;
            enabled:!root.confirm-close;
            text:root.english ? "Exit" : "Выйти";
            clicked=>{
                root.quit();
            }
        }
    }
    Label {
        x:root.content-x;
        y:17px;
        width:root.content-width;
        height:30px;
        font-size:23px;
        font-weight:650;
        text:root.page==0 ? (root.english ? "Today" : "Сегодня") : root.page==1 ? (root.english ? "Schedule" : "Расписание") : root.page==2 ? (root.english ? "Phrase library" : "Библиотека фраз") : root.page==3 ? (root.english ? "Voice and models" : "Голос и модели") : root.page==4 ? (root.english ? "Character" : "Персонаж") : root.page==6 ? (root.english ? "Data and space" : "Данные и место") : root.page==7 ? (root.english ? "Help and updates" : "Помощь и обновления") : (root.english ? "Settings" : "Настройки");
    }
    Label {
        x:root.content-x;
        y:49px;
        width:root.content-width;
        height:20px;
        font-size:11px;
        color:Colors.muted;
        text:root.background-running ? root.runtime-status : (root.english ? "Settings preview" : "Предпросмотр настроек");
    }
    main-scroll := ScrollView {
        visible:root.page!=2;
        height:root.page==2 ? 0px : parent.height - 142px;
        content-y<=>root.scroll-y;
        x:root.content-x;
        y:80px;
        width:root.content-width;
        content-width:self.width;
        enabled:root.ready && !root.busy && !root.confirm-close && !root.onboarding && (!root.data-operation-active || root.page==6 || (root.page==7 && root.profile-review=="diagnostic"));
        VerticalLayout {
            padding:0px;
            spacing:10px;
            if root.page==0 : Card {
                HorizontalLayout {
                    padding:16px; spacing:16px;
                    Image {
                        width:100px; height:100px; horizontal-stretch:0; vertical-stretch:0;
                        source:root.today-custom ? root.today-image : @image-url("../../design-preview/ui/quote.svg");
                        image-fit:contain; image-rendering:root.today-pixelated ? pixelated : smooth;
                        accessible-label:root.english ? "Your companion" : "Твой персонаж";
                    }
                    Text {
                        text:root.support-texts.length>0 ? root.support-texts[mod(root.support-index,root.support-texts.length)] : (root.english ? "One small step is enough to begin." : "Для начала достаточно одного небольшого шага.");
                        wrap:word-wrap; color:Colors.ink; font-size:15px; vertical-alignment:center;
                        min-width:0px;
                    }
                }
            }
            if root.page == 0 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Next reminder" : "Ближайшее напоминание";
                    }
                    Label {
                        text:root.next-reminder;
                        min-height:25px;
                        wrap:word-wrap;
                    }
                    if root.pending-text != "" : Hint {
                        text:root.pending-text;
                    }
                    HorizontalLayout {
                        spacing:8px;
                        alignment:start;
                        min-height:32px;
                        vertical-stretch:0;
                        ActionButton {
                            text:root.english ? "Confirm" : "Подтвердить";
                            enabled:root.pending-key!="";
                            primary:true;
                            clicked=>{
                                root.confirm-reminder(root.pending-key);
                            }
                        }
                        ActionButton {
                            text:root.english ? "Pending reminders" : "Неподтверждённые";
                            clicked=>{
                                root.review-pending();
                            }
                        }
                        ActionButton {
                            text:root.english ? "Stop speech" : "Остановить речь";
                            clicked=>{
                                root.silence();
                            }
                        }
                    }
                }
            }
            if root.page == 0 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Quick actions" : "Быстрые действия";
                    }
                    HorizontalLayout {
                        spacing:8px;
                        alignment:start;
                        min-height:32px;
                        vertical-stretch:0;
                        ActionButton {
                            text:root.english ? "Stretch now" : "Разминка сейчас";
                            clicked=>{
                                root.stretch-now();
                            }
                        }
                        ActionButton {
                            text:root.english ? "Cancel stretch" : "Отменить разминку";
                            enabled:root.exercise-active;
                            clicked=>{ root.cancel-stretch(); }
                        }
                    }
                    HorizontalLayout {
                        spacing:8px;
                        alignment:start;
                        min-height:32px;
                        vertical-stretch:0;
                        ActionButton {
                            text:root.english ? "Breakfast done" : "Завтрак закончен";
                            enabled:!root.breakfast-done;
                            clicked=>{
                                root.mark-breakfast();
                            }
                        }
                        ActionButton {
                            text:root.english ? "Schedule" : "Расписание";
                            clicked=>{
                                root.page=1;
                            }
                        }
                    }
                }
            }
            if root.page == 0 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Pause reminders" : "Пауза напоминаний";
                    }
                    Hint {
                        text:root.pause-caption;
                    }
                    HorizontalLayout {
                        spacing:8px;
                        alignment:start;
                        min-height:32px;
                        vertical-stretch:0;
                        CompactSpinBox {
                            width:85px;
                            minimum:1;
                            maximum:1440;
                            value<=>root.pause-minutes-value;
                            accessible-label:root.english ? "Pause minutes" : "Минут паузы";
                        }
                        ActionButton {
                            text:root.english ? "Pause for this time" : "Пауза на это время";
                            clicked=>{
                                root.pause-minutes(root.pause-minutes-value);
                            }
                        }
                        ActionButton {
                            text:root.english ? "Until tomorrow" : "До завтра";
                            clicked=>{
                                root.pause-minutes(-1);
                            }
                        }
                        ActionButton {
                            text:root.english ? "Resume" : "Продолжить";
                            clicked=>{
                                root.pause-minutes(0);
                            }
                        }
                    }
                }
            }
            if root.page==0 && root.archive-total>0 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Pending messages" : "Неподтверждённые сообщения";
                    }
                    for notice in root.archived-notices : HorizontalLayout {
                        spacing:8px;
                        Label {
                            text:notice.caption;
                            max-width:130px;
                            font-size:11px;
                        }
                        Label {
                            text:notice.text;
                            wrap:word-wrap;
                            min-height:32px;
                        }
                        ActionButton {
                            text:root.english ? "Confirm" : "Подтвердить";
                            clicked=>{
                                root.confirm-archived(notice.identifier);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing:8px;
                        alignment:start;
                        min-height:32px;
                        vertical-stretch:0;
                        ActionButton {
                            text:root.english ? "Previous" : "Назад";
                            enabled:root.archive-page-index>0;
                            clicked=>{
                                root.archive-page(-1);
                            }
                        }
                        ActionButton {
                            text:root.english ? "Next" : "Далее";
                            enabled:root.archive-has-next;
                            clicked=>{
                                root.archive-page(1);
                            }
                        }
                    }
                }
            }
            if root.page == 1 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Work days and breaks" : "Рабочие дни и перерывы";
                    }
                    HorizontalLayout {
                        spacing:8px;
                        alignment:start;
                        min-height:32px;
                        vertical-stretch:0;
                        ChoiceToggle {
                            text:root.english ? "Mo" : "Пн";
                            checked<=>root.monday;
                            toggled=>{
                                root.edited();
                            }
                            max-width:52px;
                        }
                        ChoiceToggle {
                            text:root.english ? "Tu" : "Вт";
                            checked<=>root.tuesday;
                            toggled=>{
                                root.edited();
                            }
                            max-width:52px;
                        }
                        ChoiceToggle {
                            text:root.english ? "We" : "Ср";
                            checked<=>root.wednesday;
                            toggled=>{
                                root.edited();
                            }
                            max-width:52px;
                        }
                        ChoiceToggle {
                            text:root.english ? "Th" : "Чт";
                            checked<=>root.thursday;
                            toggled=>{
                                root.edited();
                            }
                            max-width:52px;
                        }
                        ChoiceToggle {
                            text:root.english ? "Fr" : "Пт";
                            checked<=>root.friday;
                            toggled=>{
                                root.edited();
                            }
                            max-width:52px;
                        }
                        ChoiceToggle {
                            text:root.english ? "Sa" : "Сб";
                            checked<=>root.saturday;
                            toggled=>{
                                root.edited();
                            }
                            max-width:52px;
                        }
                        ChoiceToggle {
                            text:root.english ? "Su" : "Вс";
                            checked<=>root.sunday;
                            toggled=>{
                                root.edited();
                            }
                            max-width:52px;
                        }
                    }
                    HorizontalLayout {
                        spacing:8px;
                        alignment:start;
                        min-height:32px;
                        vertical-stretch:0;
                        Field {
                            width:220px;
                            label-width:95px;
                            title:root.english ? "Start" : "Начало";
                            control-width:110px;
                            CompactEdit {
                                accessible-label:parent.title;
                                text<=>root.start-time;
                                edited=>{
                                    root.edited();
                                }
                            }
                        }
                        Field {
                            width:220px;
                            label-width:95px;
                            title:root.english ? "End" : "Конец";
                            control-width:110px;
                            CompactEdit {
                                accessible-label:parent.title;
                                text<=>root.end-time;
                                edited=>{
                                    root.edited();
                                }
                            }
                        }
                    }
                    Field {
                        title:root.english ? "Break interval, min" : "Перерыв каждые, мин";
                        control-width:110px;
                        CompactSpinBox {
                            accessible-label:parent.title;
                            minimum:5;
                            maximum:720;
                            value<=>root.break-minutes;
                            edited=>{
                                root.edited();
                            }
                        }
                    }
                }
            }
            if root.page == 1 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Meals on work days" : "Еда в рабочие дни";
                    }
                    Toggle {
                        text:root.english ? "Enable meal reminders" : "Напоминать о еде";
                        checked<=>root.meals;
                        toggled=>{
                            root.edited();
                        }
                    }
                    Field {
                        title:root.english ? "Breakfast" : "Завтрак";
                        control-width:110px;
                        CompactEdit {
                            accessible-label:parent.title;
                            text<=>root.breakfast;
                            edited=>{
                                root.edited();
                            }
                        }
                    }
                    Field {
                        title:root.english ? "Lunch" : "Обед";
                        control-width:110px;
                        CompactEdit {
                            accessible-label:parent.title;
                            text<=>root.lunch;
                            edited=>{
                                root.edited();
                            }
                        }
                    }
                    Field {
                        title:root.english ? "Dinner" : "Ужин";
                        control-width:110px;
                        CompactEdit {
                            accessible-label:parent.title;
                            text<=>root.dinner;
                            edited=>{
                                root.edited();
                            }
                        }
                    }
                }
            }
            if root.page == 1 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Daily stretch" : "Разминка каждый день";
                    }
                    Toggle {
                        text:root.english ? "After breakfast confirmation" : "После отметки завтрака";
                        checked<=>root.stretch;
                        toggled=>{
                            root.edited();
                        }
                    }
                    Field {
                        title:root.english ? "Delay, minutes" : "Через сколько, мин";
                        control-width:110px;
                        CompactSpinBox {
                            accessible-label:parent.title;
                            minimum:1;
                            maximum:1440;
                            value<=>root.stretch-minutes;
                            edited=>{
                                root.edited();
                            }
                        }
                        hint:root.english ? "Includes weekends. The timer starts after Breakfast done." : "Включая выходные. Таймер начинается после кнопки «Завтрак закончен».";
                    }
                }
            }
            if root.page == 3 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Text and voice" : "Текст и голос";
                    }
                    Toggle {
                        text:root.english ? "Generate texts locally" : "Создавать тексты локальной моделью";
                        checked<=>root.text-enabled;
                        toggled=>{
                            root.edited();
                        }
                    }
                    Field {
                        title:root.english ? "Text model" : "Модель текста";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.text-model-index;
                            model:root.text-catalog;
                            selected=>{
                                root.text-enabled=true;
                                root.edited();
                            }
                        }
                        hint:!root.text-enabled ? (root.english ? "Ready-made phrases are used. Choose a text model to create your own." : "Используются готовые фразы. Для своих выбери модель текста.") : root.text-readiness-list[root.text-model-index];
                    }
                    Field {
                        title:root.english ? "Voice model" : "Модель голоса";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.voice-model-index;
                            model:root.voice-catalog;
                            selected=>{
                                root.edited();
                            }
                        }
                        hint:root.voice-readiness-list[root.voice-model-index];
                    }
                    Field {
                        title:root.english ? "Voice preset" : "Голосовой пресет";
                        CompactComboBox {
                            accessible-label:parent.title;
                            enabled:root.voice-model-index!=0;
                            current-index<=>root.voice-profile-index;
                            model:root.voice-profile-names;
                            selected=>{
                                root.edited();
                            }
                        }
                    }
                    Field {
                        title:root.english ? "Compute device" : "Устройство";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.compute-device;
                            model:["Auto", "CPU", "NVIDIA CUDA"];
                            selected=>{
                                root.edited();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing:8px;
                        alignment:start;
                        min-height:32px;
                        vertical-stretch:0;
                        ActionButton {
                            text:root.english ? "Set up models" : "Подготовить модели";
                            enabled:!root.busy;
                            primary:true;
                            clicked=>{
                                root.install-models();
                            }
                        }
                        ActionButton {
                            text:root.english ? "Details…" : "Подробнее…";
                            clicked=>{
                                root.model-advanced=!root.model-advanced;
                            }
                        }
                    }
                    Hint {
                        text:root.english ? "One action saves the model selection and prepares all required components. Progress appears in Tasks." : "Одна кнопка сохранит выбор моделей и подготовит все нужные компоненты. Ход работы — слева в «Задачах».";
                    }
                }
            }
            if root.page == 3 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "When to generate phrases" : "Когда создавать фразы";
                    }
                    Toggle {
                        text:root.english ? "New phrase at each event" : "Новая фраза при каждом событии";
                        checked<=>root.runtime-generation;
                        toggled=>{
                            root.edited();
                        }
                    }
                    if root.runtime-generation : VerticalLayout {
                        spacing:8px;
                        Field {
                            title:root.english ? "Event text model" : "Модель для событий";
                            CompactComboBox {
                                accessible-label:parent.title;
                                current-index<=>root.runtime-model-index;
                                model:root.text-catalog;
                                selected=>{
                                    if root.runtime-generation { root.text-enabled=true; }
                                    root.edited();
                                }
                            }
                        }
                        Field {
                            title:root.english ? "Wait for new phrase, sec" : "Ждать новую фразу, с";
                            control-width:110px;
                            CompactSpinBox {
                                accessible-label:parent.title;
                                minimum:1;
                                maximum:120;
                                value<=>root.runtime-seconds;
                                edited=>{
                                    root.edited();
                                }
                            }
                        }
                    }
                    Toggle {
                        text:root.english ? "Prepare phrases once at the start of each day" : "Готовить фразы один раз в начале дня";
                        checked<=>root.auto-daily;
                        toggled=>{
                            root.edited();
                        }
                    }
                    Toggle {
                        text:root.english ? "Keep daily phrases automatically" : "Сразу оставлять новые дневные фразы";
                        checked<=>root.auto-keep;
                        toggled=>{
                            root.edited();
                        }
                    }
                    Toggle {
                        text:root.english ? "Background generation on AC power" : "Фоновая генерация только от розетки";
                        checked<=>root.generation-ac-only;
                        toggled=>{
                            root.edited();
                        }
                    }
                }
            }
            if root.page==3 && root.model-advanced : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Files and maintenance" : "Файлы и обслуживание";
                    }
                    Hint {
                        text:root.text-notes[root.text-model-index];
                    }
                    Hint {
                        text:root.voice-notes[root.voice-model-index];
                    }
                    Field {
                        title:root.english ? "Model" : "Модель";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.path-model-index;
                            model:root.path-model-names;
                            selected=>{
                                root.path-selected();
                            }
                        }
                    }
                    Field {
                        title:root.english ? "Custom model folder" : "Своя папка модели";
                        CompactEdit {
                            text<=>root.path-model-value;
                            accessible-label:parent.title;
                            edited=>{
                                root.path-edited();
                                root.edited();
                            }
                        }
                    }
                    ActionButton {
                        text:root.english ? "Repair components" : "Восстановить компоненты";
                        enabled:!root.generation-running && !root.dirty;
                        clicked=>{
                            root.repair-environment();
                        }
                    }
                }
            }
            if root.page == 4 : Card {
                VerticalLayout {
                    padding:16px; spacing:8px;
                    SectionTitle { text:root.english ? "Choose a character" : "Выбрать персонажа"; }
                    Field {
                        title:root.english ? "Complete character" : "Персонаж целиком";
                        hint:root.english ? "Character, voice, appearance and delivery. Edit each part in Components." : "Характер, голос, внешность и подача. Отдельные части — во вкладке «Составляющие».";
                        CompactComboBox {
                            accessible-label:parent.title; model:root.character-names;
                            current-index<=>root.character-index;
                            selected=>{ root.character-selected(); root.edited(); }
                        }
                    }
                    Field {
                        title:root.english ? "New pack name" : "Имя нового набора";
                        CompactEdit { text<=>root.character-pack-name; accessible-label:parent.title; }
                    }
                    HorizontalLayout {
                        spacing:8px; alignment:start; vertical-stretch:0;
                        ActionButton { text:root.english ? "Import character…" : "Импорт персонажа…"; enabled:!root.generation-running; clicked=>{ root.import-character(); } }
                        ActionButton { text:root.english ? "Save a new pack" : "Сохранить новый набор"; enabled:!root.generation-running; clicked=>{ root.save-character-pack(); } }
                    }
                    if root.character-feedback!="" : Hint { text:root.character-feedback; color:Colors.accent; }
                }
            }
            if root.page==4 : HorizontalLayout {
                spacing:4px; alignment:start; vertical-stretch:0; height:36px;
                TabButton {
                    text:root.english ? "Components" : "Составляющие"; selected:!root.preset-management;
                    clicked=>{ root.character-options=true; root.preset-management=false; }
                }
                TabButton {
                    text:root.english ? "My presets" : "Мои пресеты"; selected:root.preset-management;
                    clicked=>{ root.preset-management=true; root.character-options=false; }
                }
            }
            if root.page==4 && !root.preset-management : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Character components" : "Составляющие персонажа";
                    }
                    TextEdit {
                        height:140px;
                        text<=>root.character-description;
                        accessible-label:root.english ? "Character description" : "Описание характера";
                        edited=>{
                            root.edited();
                        }
                    }
                    Field {
                        title:root.english ? "Voice" : "Голос";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.voice-profile-index;
                            model:root.voice-profile-names;
                            selected=>{
                                root.edited();
                            }
                        }
                    }
                    Field {
                        title:root.english ? "Appearance" : "Внешность";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.visual-index;
                            model:root.visual-names;
                            selected=>{
                                root.edited();
                            }
                        }
                    }
                    Field {
                        title:root.english ? "Mascot size" : "Размер маскота";
                        control-width:110px;
                        CompactSpinBox {
                            accessible-label:parent.title;
                            minimum:80;
                            maximum:260;
                            value<=>root.pet-size;
                            edited=>{
                                root.edited();
                            }
                        }
                    }
                    Toggle {
                        text:root.english ? "Allow swearing" : "Разрешить мат";
                        checked<=>root.swear;
                        toggled=>{
                            root.edited();
                        }
                    }
                    Field {
                        title:root.english ? "Delivery" : "Подача";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.delivery-index;
                            model:root.delivery-names;
                            selected=>{
                                root.edited();
                            }
                        }
                    }
                    if root.delivery-index==1 : CompactEdit {
                        text<=>root.custom-instruction;
                        placeholder-text:root.english ? "Acting instruction" : "Инструкция подачи";
                        edited=>{
                            root.edited();
                        }
                    }
                    ActionButton {
                        text:root.english ? "Add delivery…" : "Добавить свою подачу…";
                        clicked=>{
                            root.delivery-editor=!root.delivery-editor;
                        }
                    }
                    if root.delivery-editor : VerticalLayout {
                        spacing:6px;
                        CompactEdit {
                            text<=>root.delivery-name;
                            placeholder-text:root.english ? "Delivery name" : "Название подачи";
                        }
                        CompactEdit {
                            text<=>root.delivery-instruction;
                            placeholder-text:root.english ? "Acting instruction in English" : "Инструкция актёру на английском";
                        }
                        HorizontalLayout {
                            spacing:8px;
                            alignment:start;
                            min-height:32px;
                            vertical-stretch:0;
                            ActionButton {
                                text:root.english ? "Add" : "Добавить";
                                clicked=>{
                                    root.add-delivery();
                                }
                            }
                            ActionButton {
                                text:root.english ? "Remove selected" : "Удалить выбранную";
                                enabled:root.delivery-index>=2;
                                clicked=>{
                                    root.remove-delivery();
                                }
                            }
                        }
                    }
                    Hint {
                        text:root.english ? "CosyVoice supports acting instructions. Qwen Base uses its reference voice." : "CosyVoice поддерживает инструкции подачи. Qwen Base использует голос референса.";
                    }
                }
            }
            if root.page==4 && root.preset-management : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    Label {
                        text: root.english ? "My presets · import, edit, export" : "Мои пресеты · импорт, правка, экспорт";
                        height: 24px;
                        font-size: 15px;
                        font-weight: 600;
                    }
                    ActionButton {
                        text:root.preset-import-options ? (root.english ? "Hide component import" : "Скрыть импорт части") : (root.english ? "Import a component…" : "Импорт отдельной части…");
                        clicked=>{ root.preset-import-options=!root.preset-import-options; }
                    }
                    if root.preset-import-options : VerticalLayout {
                        spacing:8px;
                    SectionTitle { text:root.english ? "Import" : "Импорт"; }
                    Field { title:root.english ? "File contents" : "Содержимое файла";
                        CompactComboBox {
                            accessible-label: root.english ? "Import type" : "Тип импорта";
                            model: root.english ? ["Character", "Voice", "Appearance"] : ["Характер", "Голос", "Внешность"];
                            current-index <=> root.import-kind;
                        } }
                    ActionButton {
                        text:root.import-help ? (root.english ? "Hide requirements" : "Скрыть требования") : (root.english ? "File requirements…" : "Требования к файлам…");
                        clicked=>{ root.import-help=!root.import-help; }
                    }

                    if root.import-help : Hint {
                        text: root.english ? "Import .kavychka / preset.json, TXT, image, or audio. Voice: 1–30 seconds of clean speech, at least 16 kHz; transcript should match. Images: up to 40M pixels. GIF: up to 300 frames and 40M decoded pixels in total. Codex atlas: 1536 × 1872. Files up to 200 MiB. Audio is converted locally when a compatible media runtime is installed." : "Импорт .kavychka / preset.json, TXT, картинки или звука. Голос: 1–30 секунд чистой речи, от 16 кГц; расшифровка должна совпадать. Картинка: до 40 млн пикселей. GIF: до 300 кадров и суммарно 40 млн декодированных пикселей. Атлас Codex: 1536 × 1872. До 200 МиБ. Звук преобразуется локально при установленной совместимой среде медиа.";
                        wrap: word-wrap;
                        color: Colors.muted;
                        font-size: 12px;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        CompactEdit {
                            accessible-label: root.english ? "File to import" : "Файл для импорта";
                            text <=> root.import-path;
                            placeholder-text: root.english ? "Preset file" : "Файл пресета";
                        }
                        ActionButton {
                            text: "…";
                            accessible-label: root.english ? "Choose preset or media file" : "Выбрать файл пресета или медиа";
                            clicked => {
                                root.choose-preset-file();
                            }
                        }
                        ActionButton {
                            text: root.english ? "Import" : "Импорт";
                            clicked => {
                                root.import-preset();
                            }
                        }
                    }
                    if root.import-kind == 1 : Field {
                        control-min-height:80px;
                        title: root.english ? "Transcript for imported audio · optional" : "Расшифровка импортируемого голоса · необязательно";
                        TextEdit {
                            accessible-label: parent.title;
                            text <=> root.import-transcript;
                            height: 80px;
                        }
                    }
                    }
                    SectionTitle { text:root.english ? "Saved presets" : "Сохранённые пресеты"; }
                    Field {
                        title: root.english ? "Preset" : "Пресет";
                        CompactComboBox {
                            accessible-label: parent.title;
                            model: root.preset-names;
                            current-index <=> root.preset-index;
                            selected => {
                                root.preset-selected();
                            }
                        }
                    }
                    Field { title:root.english ? "Name" : "Название";
                        CompactEdit {
                            accessible-label: root.english ? "Preset name" : "Название пресета";
                            text <=> root.preset-name;
                            placeholder-text: root.english ? "Preset name" : "Название пресета";
                        } }

                    if root.reference-names.length>1 : Field {
                        title:root.english ? "Edit component" : "Редактировать часть";
                        CompactComboBox {
                            accessible-label: root.english ? "Voice reference" : "Голосовой референс";
                            model: root.reference-names;
                            current-index <=> root.reference-index;
                            selected => {
                                root.reference-selected();
                            }
                        }
                    }
                    Hint { text:root.preset-body-label; }
                    if !root.preset-editing-visual : TextEdit {
                        accessible-label: root.english ? "Preset content" : "Содержимое пресета";
                        text <=> root.preset-body;
                        height: 130px;
                    }
                    if root.preset-editing-visual : Field {
                        title: root.english ? "Appearance layout" : "Формат внешности";
                        CompactComboBox {
                            accessible-label: parent.title;
                            model: root.english ? ["Auto", "Image", "Codex atlas 1536 × 1872", "Pixel art · nearest", "Smooth artwork"] : ["Авто", "Изображение", "Атлас Codex 1536 × 1872", "Пиксели · nearest", "Плавное изображение"];
                            current-index <=> root.visual-layout;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment:start; vertical-stretch:0;
                        ActionButton {
                            text: root.english ? "Save changes" : "Сохранить изменения";
                            clicked => {
                                root.save-preset();
                            }
                        }
                        ActionButton {
                            enabled: root.preset-index > 0;
                            text: root.english ? "Export preset" : "Экспорт пресета";
                            clicked => {
                                root.export-preset();
                            }
                        }
                        ActionButton {
                            enabled: root.preset-index > 0;
                            text: root.english ? "Delete…" : "Удалить…";
                            clicked => {
                                root.confirm-preset-delete = true;
                            }
                        }
                    }
                    if root.confirm-preset-delete : HorizontalLayout {
                        Label {
                            text: root.english ? "Delete this preset?" : "Удалить этот пресет?";
                        }
                        ActionButton {
                            text: root.english ? "Delete" : "Удалить";
                            clicked => {
                                root.delete-preset();
                                root.confirm-preset-delete = false;
                            }
                        }
                        ActionButton {
                            text: root.english ? "Cancel" : "Отмена";
                            clicked => {
                                root.confirm-preset-delete = false;
                            }
                        }
                    }
                }
            }
            if root.page == 5 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Appearance and language" : "Оформление и язык";
                    }
                    Field {
                        title:root.english ? "Theme" : "Тема";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.theme-index;
                            model:root.english ? ["System", "Light", "Dark"] : ["Как в системе", "Светлая", "Тёмная"];
                            selected=>{
                                root.edited();
                            }
                        }
                    }
                    Field {
                        title:root.english ? "Interface" : "Интерфейс";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.language-index;
                            model:["Русский", "English"];
                            selected=>{
                                root.edited();
                            }
                        }
                    }
                    Field {
                        title:root.english ? "Speech language" : "Язык озвучки";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.speech-index;
                            model:["Русский", "English"];
                            selected=>{
                                root.edited();
                            }
                        }
                    }
                    Field {
                        title:root.english ? "Time zone" : "Часовой пояс";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.time-zone-index;
                            model:root.time-zone-names;
                            selected=>{
                                root.time-zone=root.time-zone-ids[root.time-zone-index];
                                root.edited();
                            }
                        }
                    }
                    Toggle {
                        text:root.english ? "Start when signing in" : "Запускать при входе в Windows";
                        checked<=>root.run-at-login;
                        toggled=>{
                            root.edited();
                        }
                    }
                    Toggle {
                        text:root.english ? "Check for updates automatically" : "Проверять обновления автоматически";
                        checked<=>root.automatic-updates;
                        toggled=>{
                            root.edited();
                        }
                    }
                }
            }
            if root.page == 5 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "How to address you" : "Обращение";
                    }
                    Field {
                        title:root.english ? "Name, optional" : "Имя, необязательно";
                        CompactEdit {
                            accessible-label:parent.title;
                            text<=>root.user-name;
                            edited=>{
                                root.edited();
                            }
                        }
                    }
                    Field {
                        title:root.english ? "Address form" : "Обращение";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.address-index;
                            model:root.english ? ["Neutral", "Feminine", "Masculine"] : ["Нейтрально", "В женском роде", "В мужском роде"];
                            selected=>{
                                root.edited();
                            }
                        }
                    }
                }
            }
            if root.page == 5 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Rest and repeat reminders" : "Отдых и повторные напоминания";
                    }
                    Field {
                        title:root.english ? "Idle rest, minutes" : "Отдых без активности, мин";
                        control-width:110px;
                        CompactSpinBox {
                            accessible-label:parent.title;
                            minimum:1;
                            maximum:120;
                            value<=>root.idle-minutes;
                            edited=>{
                                root.edited();
                            }
                        }
                    }
                    Field {
                        title:root.english ? "Allowed incidental clicks" : "Допустимых случайных кликов";
                        control-width:110px;
                        CompactSpinBox {
                            accessible-label:parent.title;
                            minimum:0;
                            maximum:100;
                            value<=>root.allowed-clicks;
                            edited=>{
                                root.edited();
                            }
                        }
                    }
                    Field {
                        title:root.english ? "Repeat after, minutes" : "Повторять через, мин";
                        control-width:110px;
                        CompactSpinBox {
                            accessible-label:parent.title;
                            minimum:1;
                            maximum:120;
                            value<=>root.repeat-minutes;
                            edited=>{
                                root.edited();
                            }
                        }
                    }
                    Toggle {
                        text:root.english ? "Trust confirmation immediately" : "Доверять кнопке подтверждения";
                        checked<=>root.trust-confirmation;
                        toggled=>{
                            root.edited();
                        }
                        hint:root.english ? "Otherwise repeats stop after sufficient mouse and keyboard inactivity." : "Иначе повтор прекращается после настоящего отдыха от мыши и клавиатуры.";
                    }

                    Field {
                        title:root.english ? "Break repeats" : "Повторов перерыва";
                        control-width:110px;
                        CompactSpinBox {
                            accessible-label:parent.title; minimum:0; maximum:20;
                            value<=>root.break-repeats; edited=>{ root.edited(); }
                        }
                    }
                    Field {
                        title:root.english ? "Stretch repeats" : "Повторов разминки";
                        control-width:110px;
                        CompactSpinBox {
                            accessible-label:parent.title; minimum:0; maximum:20;
                            value<=>root.exercise-repeats; edited=>{ root.edited(); }
                        }
                    }
                    Field {
                        title:root.english ? "Meal repeats" : "Повторов еды";
                        control-width:110px;
                        CompactSpinBox {
                            accessible-label:parent.title;
                            minimum:0;
                            maximum:20;
                            value<=>root.meal-repeats;
                            edited=>{
                                root.edited();
                            }
                        }
                    }
                }
            }
            if root.page == 5 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Audio and companion" : "Звук и маскот";
                    }
                    Field {
                        title:root.english ? "Reminder audio" : "Звук напоминаний";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.audio-index;
                            model:root.english ? ["Chime and voice", "Chime", "Voice", "Silent"] : ["Сигнал и голос", "Сигнал", "Голос", "Тишина"];
                            selected=>{
                                root.edited();
                            }
                        }
                    }
                    Field {
                        title:root.english ? "Audio output" : "Устройство озвучки";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.audio-device-index;
                            model:root.audio-device-names;
                            selected=>{
                                root.audio-device-id=root.audio-device-ids[root.audio-device-index];
                                root.edited();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing:8px;
                        alignment:start;
                        min-height:32px;
                        vertical-stretch:0;
                        ActionButton {
                            text:root.english ? "Refresh devices" : "Обновить устройства";
                            enabled:!root.audio-refreshing;
                            clicked=>{
                                root.refresh-audio();
                            }
                        }
                        ActionButton {
                            text:root.english ? "Chime" : "Сигнал";
                            clicked=>{
                                root.test-audio(0);
                            }
                        }
                        ActionButton {
                            text:root.english ? "Voice" : "Голос";
                            clicked=>{
                                root.test-audio(1);
                            }
                        }
                        ActionButton {
                            text:root.english ? "Stop" : "Стоп";
                            clicked=>{
                                root.silence();
                            }
                        }
                    }
                    if root.audio-test-status!="" : Hint {
                        text:root.audio-test-status;
                    }
                    Toggle {
                        text:root.english ? "Show companion" : "Показывать маскота";
                        checked<=>root.pet-visible;
                        toggled=>{
                            root.edited();
                        }
                    }
                    Field {
                        title:root.english ? "Animation" : "Анимация";
                        hint:root.english ? "Idle movement follows this mode. Speech and confirmation reactions can play between cycles. Off stops all animations." : "Режим управляет движением в покое. Реакции на речь и подтверждение могут проигрываться между циклами. «Выключена» останавливает все анимации.";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index: root.animation ? root.animation-index : 0;
                            model:root.english ? ["Off", "With pauses", "Continuous"] : ["Выключена", "С паузами", "Непрерывно"];
                            selected=>{
                                let choice = self.current-index;
                                root.animation-index=choice;
                                root.animation=choice!=0;
                                root.edited();
                            }
                        }
                    }
                    if root.animation && root.animation-index == 1 : Field {
                        title:root.english ? "Idle animation, sec" : "Движение в покое, сек";
                        control-width:110px;
                        CompactSpinBox {
                            accessible-label:parent.title;
                            minimum:1; maximum:300;
                            value<=>root.idle-play-seconds;
                            edited=>{ root.edited(); }
                        }
                    }
                    if root.animation && root.animation-index == 1 : Field {
                        title:root.english ? "Animation pause, sec" : "Пауза движения, сек";
                        control-width:110px;
                        CompactSpinBox {
                            accessible-label:parent.title;
                            minimum:1; maximum:3600;
                            value<=>root.idle-pause-seconds;
                            edited=>{ root.edited(); }
                        }
                    }
                    Field {
                        title:root.english ? "Over fullscreen apps" : "Поверх полного экрана";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.fullscreen-visual-index;
                            model:root.english ? ["Companion and message", "Message", "Nothing"] : ["Маскот и сообщение", "Только сообщение", "Ничего"];
                            selected=>{
                                root.edited();
                            }
                        }
                    }
                    Field {
                        title:root.english ? "Fullscreen audio" : "Звук в полном экране";
                        CompactComboBox {
                            accessible-label:parent.title;
                            current-index<=>root.fullscreen-audio-index;
                            model:root.english ? ["Chime and voice", "Chime", "Voice", "Silent"] : ["Сигнал и голос", "Сигнал", "Голос", "Тишина"];
                            selected=>{
                                root.edited();
                            }
                        }
                    }
                    Toggle {
                        text:root.english ? "Defer generation in fullscreen" : "Откладывать генерацию при полном экране";
                        checked<=>root.generation-fullscreen;
                        toggled=>{
                            root.edited();
                        }
                    }
                    Toggle {
                        text:root.english ? "Override Windows notification restrictions" : "Напоминать при ограничении Windows";
                        checked<=>root.allow-during-dnd;
                        toggled=>{
                            root.edited();
                        }
                    }
                    Hint {
                        text:root.english ? "Windows does not always expose exact Do Not Disturb state. Use Pause for guaranteed silence." : "Windows не всегда сообщает точное состояние «Не беспокоить». Для гарантированной тишины используй паузу.";
                    }
                }
            }
            if root.page == 6 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Where your files are stored" : "Где хранятся данные";
                    }
                    Hint {
                        text:root.english ? "Settings, presets and recordings live here and survive application updates." : "Здесь настройки, пресеты и записи. Файлы сохраняются при обновлении программы.";
                    }
                    CompactEdit {
                        text:root.storage-path;
                        read-only:true;
                        accessible-label:root.english ? "Data folder" : "Папка данных";
                    }
                    ActionButton {
                        text:root.english ? "Advanced options" : "Дополнительные параметры";
                        clicked=>{
                            root.data-advanced=!root.data-advanced;
                        }
                    }
                    if root.data-advanced : VerticalLayout {
                        spacing:8px;
                        Field {
                            title:root.english ? "Backup limit, MB" : "Лимит резервов, МБ";
                            control-width:110px;
                            CompactSpinBox {
                                accessible-label:parent.title;
                                minimum:100;
                                maximum:100000;
                                value<=>root.recovery-limit-mb;
                                edited=>{
                                    root.edited();
                                }
                            }
                            hint:root.english ? "Update backups and recoverable recordings use this limit. Model weights are not duplicated." : "Резервы обновлений и удалённые записи используют этот лимит. Веса моделей не дублируются.";
                        }
                    }
                }
            }
            if root.page == 6 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    Field {
                        title:root.english ? "Data operation" : "Операция с данными";
                        CompactComboBox {
                            model:root.english ? ["Export profile","Restore profile","Move shared storage"] : ["Экспорт профиля","Восстановление профиля","Перенос общей папки"];
                            current-index <=> root.profile-operation-index;
                            enabled:!root.profile-running && !root.transfer-busy;
                            accessible-label:parent.title;
                            selected=>{
                                root.profile-action(5);
                                root.transfer-cancel();
                            }
                        }
                    }
                    if root.profile-operation-index==0 : VerticalLayout {
                        spacing:8px;
                        Label {
                            text: root.english ? "Export profile" : "Экспорт профиля";
                            height:24px;
                            font-weight:600;
                        }
                        Toggle {
                            text:root.english ? "Include phrase library and history" : "Включить библиотеку и историю";
                            checked <=> root.profile-include-library;
                            enabled:!root.profile-running;
                            toggled => {
                                root.profile-action(5);
                            }
                        }
                        Toggle {
                            text:root.english ? "Include generated recordings" : "Включить сгенерированные записи";
                            checked <=> root.profile-include-audio;
                            enabled:!root.profile-running && root.profile-include-library;
                            toggled => {
                                root.profile-action(5);
                            }
                        }
                        Label {
                            height:42px;
                            wrap:word-wrap;
                            color:Colors.muted;
                            text:root.english ? "Settings, character and voice/visual presets with their own references are included. Backups, quarantine, code, models and private logs are excluded." : "Настройки и пресеты характера, голоса и внешности с их референсами включены. Резервы, карантин, код, модели и частные логи исключены.";
                        }
                        CompactEdit {
                            text <=> root.profile-export-path;
                            accessible-label:root.english ? "New profile ZIP path" : "Путь нового ZIP профиля";
                            enabled:!root.profile-running;
                        }
                        HorizontalLayout {
                            spacing:8px;
                            ActionButton {
                                text:root.english ? "Choose ZIP…" : "Выбрать ZIP…";
                                enabled:!root.profile-running;
                                clicked => {
                                    root.profile-browse(true);
                                }
                            }
                            ActionButton {
                                text:root.english ? "Estimate" : "Рассчитать";
                                enabled:!root.profile-running && !root.dirty;
                                clicked => {
                                    root.profile-action(0);
                                }
                            }
                            ActionButton {
                                text:root.english ? "Export" : "Экспортировать";
                                enabled:!root.profile-running && !root.dirty && root.profile-review=="export";
                                clicked => {
                                    root.profile-action(1);
                                }
                            }
                        }
                    }
                    if root.profile-operation-index==1 : VerticalLayout {
                        spacing:8px;
                        Label {
                            text:root.english ? "Restore profile" : "Восстановление профиля";
                            height:24px;
                            font-weight:600;
                        }
                        CompactEdit {
                            text <=> root.profile-import-path;
                            accessible-label:root.english ? "Profile ZIP to restore" : "ZIP профиля для восстановления";
                            enabled:!root.profile-running;
                        }
                        HorizontalLayout {
                            spacing:8px;
                            ActionButton {
                                text:root.english ? "Open ZIP…" : "Открыть ZIP…";
                                enabled:!root.profile-running;
                                clicked => {
                                    root.profile-browse(false);
                                }
                            }
                            ActionButton {
                                text:root.english ? "Inspect archive" : "Проверить архив";
                                enabled:!root.profile-running && !root.dirty;
                                clicked => {
                                    root.profile-action(2);
                                }
                            }
                        }
                    }
                    if root.profile-operation-index<2 : VerticalLayout {
                        spacing:8px;
                        if root.profile-review!="" || root.profile-running : TextEdit {
                            height:150px;
                            read-only:true;
                            text:root.english ? root.profile-summary-en : root.profile-summary-ru;
                            accessible-label:root.english ? "Profile operation summary and conflicts" : "Сводка операции и конфликтов";
                        }
                        HorizontalLayout {
                            spacing:8px;
                            if root.profile-operation-index==1 : ActionButton {
                                text:root.english ? "Apply restore" : "Применить восстановление";
                                primary:true;
                                enabled:root.profile-can-apply && !root.profile-running && !root.dirty;
                                clicked => {
                                    root.profile-action(3);
                                }
                            }
                            ActionButton {
                                text:root.english ? "Cancel" : "Отменить";
                                enabled:root.data-operation-active;
                                clicked => {
                                    root.profile-action(4);
                                }
                            }
                        }
                        if root.profile-status-ru!="" : Label {
                            height:40px;
                            wrap:word-wrap;
                            text:root.english ? root.profile-status-en : root.profile-status-ru;
                            color:Colors.muted;
                        }
                        if root.profile-output!="" : CompactEdit {
                            text:root.profile-output;
                            read-only:true;
                            accessible-label:root.english ? "Result archive or backup path" : "Путь результата или резервной копии";
                        }
                    }
                    if root.profile-operation-index==2 : VerticalLayout {
                        spacing:8px;
                        Label {
                            text:root.english ? "Move shared storage" : "Перенести общую папку";
                            height:24px;
                            font-weight:600;
                        }
                        Label {
                            height:48px;
                            wrap:word-wrap;
                            color:Colors.muted;
                            text:root.english ? "Available in the installed version. All owned data, models and runtimes move together; external paths stay in place. Choose a new folder. After review, Kavychka closes for a verified copy and pointer switch. The original folder is retained." : "Доступно в установленной версии. Свои данные, модели и среды переносятся вместе; внешние пути остаются на месте. Укажи новую папку. После проверки Кавычка закроется для проверенного копирования и переключения указателя. Исходная папка сохраняется.";
                        }
                        CompactEdit {
                            text <=> root.transfer-target;
                            enabled:root.transfer-available && !root.transfer-busy;
                            accessible-label:root.english ? "New shared storage folder" : "Новая общая папка";
                        }
                        HorizontalLayout {
                            spacing:8px;
                            ActionButton {
                                text:root.english ? "Review move" : "Проверить перенос";
                                enabled:root.transfer-available && !root.transfer-busy && !root.data-operation-active && !root.update-running && !root.dirty;
                                clicked=>{
                                    root.transfer-estimate();
                                }
                            }
                            ActionButton {
                                text:root.english ? "Move and restart" : "Перенести и перезапустить";
                                enabled:root.transfer-reviewed && !root.transfer-busy && !root.data-operation-active && !root.update-running && !root.dirty;
                                clicked=>{
                                    root.transfer-apply();
                                }
                            }
                            ActionButton {
                                text:root.english ? "Cancel" : "Отменить";
                                enabled:root.transfer-busy || root.transfer-reviewed;
                                clicked=>{
                                    root.transfer-cancel();
                                }
                            }
                        }
                        if root.transfer-status!="" : TextEdit {
                            height:150px;
                            text:root.transfer-status;
                            read-only:true;
                            accessible-label:root.english ? "Storage move summary" : "Сводка переноса хранилища";
                        }
                    }
                }
            }
            if root.page == 7 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Updates" : "Обновления";
                    }
                    Label {
                        text:(root.english ? "Version " : "Версия ")+root.app-version;
                        height:22px;
                    }
                    Hint {
                        text:root.update-status;
                    }
                    HorizontalLayout {
                        spacing:8px;
                        alignment:start;
                        min-height:32px;
                        vertical-stretch:0;
                        ActionButton {
                            text:root.english ? "Check for updates" : "Проверить обновления";
                            enabled:root.installed-version && !root.update-running;
                            clicked=>{
                                root.check-updates();
                            }
                        }
                        if root.update-available && !root.update-downloaded : ActionButton {
                            text:root.english ? "Download" : "Скачать";
                            enabled:!root.update-running;
                            clicked=>{
                                root.download-update();
                            }
                        }
                        if root.update-running : ActionButton {
                            text:root.english ? "Cancel" : "Отмена";
                            clicked=>{
                                root.cancel-update();
                            }
                        }
                        if root.update-downloaded : ActionButton {
                            text:root.english ? "Update and restart" : "Обновить и перезапустить";
                            enabled:!root.dirty && !root.busy && !root.data-operation-active && !root.profile-running && !root.transfer-busy;
                            primary:true;
                            clicked=>{
                                root.apply-update();
                            }
                        }
                    }
                    if root.update-notes!="" : TextEdit {
                        height:130px;
                        text:root.update-notes;
                        read-only:true;
                        accessible-label:root.english ? "Release notes" : "Что изменилось";
                    }
                    Hint {
                        text:root.english ? "Settings and models stay in place. Save changes before restarting." : "Настройки и модели сохраняются. Перед перезапуском сохрани изменения.";
                    }
                }
            }
            if root.page == 7 : Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "Help and maintenance" : "Помощь и обслуживание";
                    }
                    Hint {
                        text:root.english ? "Closing settings keeps reminders in the tray. Use Exit to quit the application." : "Крестик закрывает настройки, напоминания остаются в трее. Для завершения приложения нажми «Выйти».";
                    }
                    HorizontalLayout {
                        spacing:8px;
                        alignment:start;
                        min-height:32px;
                        vertical-stretch:0;
                        ActionButton {
                            text:root.english ? "Preview diagnostics" : "Посмотреть диагностику";
                            enabled:!root.profile-running && !root.dirty;
                            clicked=>{
                                root.profile-action(6);
                            }
                        }
                        ActionButton {
                            text:root.english ? "Roll back update" : "Откатить обновление";
                            enabled:root.rollback-available && !root.dirty && !root.busy && !root.data-operation-active && !root.update-running;
                            clicked=>{
                                root.rollback-update();
                            }
                        }
                    }
                    if root.profile-review=="diagnostic" : VerticalLayout {
                        spacing:8px;
                        TextEdit {
                            height:170px;
                            read-only:true;
                            text:root.english ? root.profile-summary-en : root.profile-summary-ru;
                            accessible-label:root.english ? "Diagnostic report" : "Отчёт диагностики";
                        }
                        HorizontalLayout {
                            spacing:8px;
                            alignment:start;
                            min-height:32px;
                            vertical-stretch:0;
                            ActionButton {
                                text:root.english ? "Save report" : "Сохранить отчёт";
                                enabled:!root.profile-running;
                                clicked=>{
                                    root.profile-action(7);
                                }
                            }
                            ActionButton {
                                text:root.english ? "Close report" : "Закрыть отчёт";
                                clicked=>{
                                    root.profile-action(4);
                                }
                            }
                        }
                    }
                    ActionButton {
                        text:root.english ? "Uninstall application…" : "Удалить приложение…";
                        enabled:root.removal-available && !root.dirty && !root.data-operation-active && !root.update-running && !root.transfer-busy;
                        clicked=>{
                            root.open-removal();
                        }
                    }
                    AboutSlint {
                        min-height:110px;
                        preferred-height:110px;
                        vertical-stretch:0;
                        max-width:200px;
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
    Label {
        x:root.content-x;
        y:parent.height - 51px;
        width:max(0px,root.content-width - 300px);
        height:32px;
        font-size:12px;
        wrap:word-wrap;
        color:root.failed ? #d86660 : Colors.muted;
        text:root.status!="" ? root.status : root.dirty ? (root.english ? "Unsaved changes" : "Есть несохранённые изменения") : (root.english ? "Settings saved" : "Настройки сохранены");
    }
    HorizontalLayout {
        x:root.width - 315px;
        y:parent.height - 51px;
        width:295px;
        height:32px;
        spacing:8px;
        ActionButton {
            text:root.english ? "Discard" : "Отменить";
            enabled:root.ready && root.dirty && !root.busy && !root.onboarding;
            clicked=>{
                root.discard();
            }
        }
        ActionButton {
            text:root.busy ? (root.english ? "Saving…" : "Сохраняем…") : (root.english ? "Save changes" : "Сохранить");
            primary:true;
            enabled:root.ready && root.dirty && !root.busy && !root.onboarding;
            clicked=>{
                root.save();
            }
        }
    }
    changed show-task-details => {
        if(root.show-task-details) {task-details-popup.show();}
        else {task-details-popup.close();}
    }
    task-details-popup := PopupWindow {
        x:root.content-x;
        y:80px;
        width:root.content-width;
        height:min(320px,root.height - 150px);
        close-policy:no-auto-close;
        Rectangle {
            width:parent.width;
            height:parent.height;
            background:Colors.surface;
            border-width:1px;
            border-color:Colors.accent;
            border-radius:8px;
            VerticalLayout {
                padding:16px;
                spacing:8px;
                SectionTitle {
                    text:root.task-title!="" ? root.task-title : (root.english ? "Task details" : "Подробности задачи");
                }
                TextEdit {
                    read-only:true;
                    text:root.task-details!="" ? root.task-details : root.library-status;
                    accessible-label:root.english ? "Task progress and errors" : "Ход задачи и ошибки";
                }
                ActionButton {
                    text:root.english ? "Close" : "Закрыть";
                    clicked=>{
                        root.show-task-details=false;
                    }
                }
            }
        }
    }
    if root.onboarding && root.ready : Rectangle {
        width: root.width;
        height: root.height;
        background: Colors.canvas;
        VerticalLayout {
            padding: 24px;
            spacing: 10px;
            Label {
                height: 38px;
                font-size: 26px;
                font-weight: 600;
                text: root.english ? "Welcome to Kavychka" : "Привет, я Кавычка";
            }
            Label {
                height: 26px;
                color: Colors.muted;
                text: (root.setup-step + 1) + " / 4 · " + (root.setup-step == 0 ? (root.english ? "Language and name" : "Язык и имя") : root.setup-step == 1 ? (root.english ? "Your schedule" : "Твоё расписание") : root.setup-step == 2 ? (root.english ? "Try a reminder" : "Проверка напоминания") : (root.english ? "Optional models" : "Модели — по желанию"));
            }
            onboarding-scroll := ScrollView {
                content-y <=> root.onboarding-scroll-y;
                content-width: self.width;
                VerticalLayout {
                    spacing: 8px;
                    padding-bottom:12px;
                    if root.setup-step == 0 : VerticalLayout {
                        spacing: 12px;
                        Field {
                            title: root.english ? "Interface" : "Интерфейс";
                            CompactComboBox {
                                model: ["Русский", "English"];
                                current-index <=> root.language-index;
                                accessible-label: parent.title;
                                selected => {
                                    root.edited();
                                }
                            }
                        }
                        Field {
                            title: root.english ? "Speech" : "Озвучка";
                            CompactComboBox {
                                model: ["Русский", "English"];
                                current-index <=> root.speech-index;
                                accessible-label: parent.title;
                                selected => {
                                    root.edited();
                                }
                            }
                        }
                        Field {
                            title: root.english ? "Your name · optional" : "Твоё имя · необязательно";
                            CompactEdit {
                                text <=> root.user-name;
                                accessible-label: parent.title;
                                edited => {
                                    root.edited();
                                }
                            }
                        }
                        Field {
                            title: root.english ? "Address me as" : "Обращаться ко мне";
                            CompactComboBox {
                                model: root.english ? ["Neutral", "Feminine", "Masculine"] : ["Нейтрально", "В женском роде", "В мужском роде"];
                                current-index <=> root.address-index;
                                accessible-label: parent.title;
                                selected => {
                                    root.edited();
                                }
                            }
                        }
                        ChoiceToggle {
                            text:root.english ? "Restore a full profile backup" : "Восстановить полный резерв профиля";
                            checked<=>root.restore-onboarding;
                        }
                        if root.restore-onboarding : Hint {
                            text:root.english ? "Only full Kavychka backups belong here. Import character packs after setup in Character." : "Здесь только полный резерв Кавычки. Набор персонажа импортируется после настройки в разделе «Персонаж».";
                        }
                        if root.restore-onboarding : ActionButton {
                            text:root.english ? "Open profile archive…" : "Открыть архив профиля…";
                            enabled:!root.profile-running;
                            clicked => {
                                root.profile-browse(false);
                            }
                        }
                        if root.profile-review=="restore" : TextEdit {
                            height:200px;
                            read-only:true;
                            text:root.english ? root.profile-summary-en : root.profile-summary-ru;
                            accessible-label:root.english ? "Restore summary" : "Сводка восстановления";
                        }
                        if root.data-operation-active : HorizontalLayout {
                            spacing:8px;
                            ActionButton {
                                text:root.english ? "Apply restore" : "Применить восстановление";
                                primary:true;
                                enabled:root.profile-can-apply && !root.profile-running;
                                clicked => {
                                    root.profile-action(3);
                                }
                            }
                            ActionButton {
                                text:root.english ? "Cancel" : "Отменить";
                                clicked => {
                                    root.profile-action(4);
                                }
                            }
                        }
                        Label {
                            height:90px;
                            wrap:word-wrap;
                            color:Colors.muted;
                            text:root.english ? root.profile-status-en : root.profile-status-ru;
                        }
                    }
                    if root.setup-step == 1 : VerticalLayout {
                        spacing: 12px;
                        Label {
                            height: 32px;
                            text: root.english ? "Reminder days" : "Дни напоминаний";
                        }
                        HorizontalLayout {
                            height: 36px;
                            ChoiceToggle {
                                text: root.english ? "Mo" : "Пн";
                                checked <=> root.monday;
                                toggled => {
                                    root.edited();
                                }
                            }
                            ChoiceToggle {
                                text: root.english ? "Tu" : "Вт";
                                checked <=> root.tuesday;
                                toggled => {
                                    root.edited();
                                }
                            }
                            ChoiceToggle {
                                text: root.english ? "We" : "Ср";
                                checked <=> root.wednesday;
                                toggled => {
                                    root.edited();
                                }
                            }
                            ChoiceToggle {
                                text: root.english ? "Th" : "Чт";
                                checked <=> root.thursday;
                                toggled => {
                                    root.edited();
                                }
                            }
                            ChoiceToggle {
                                text: root.english ? "Fr" : "Пт";
                                checked <=> root.friday;
                                toggled => {
                                    root.edited();
                                }
                            }
                            ChoiceToggle {
                                text: root.english ? "Sa" : "Сб";
                                checked <=> root.saturday;
                                toggled => {
                                    root.edited();
                                }
                            }
                            ChoiceToggle {
                                text: root.english ? "Su" : "Вс";
                                checked <=> root.sunday;
                                toggled => {
                                    root.edited();
                                }
                            }
                        }
                        Field {
                            title: root.english ? "Work starts · HH:MM" : "Начало работы · ЧЧ:ММ";
                            CompactEdit {
                                text <=> root.start-time;
                                accessible-label: parent.title;
                                edited => {
                                    root.edited();
                                }
                            }
                        }
                        Field {
                            title: root.english ? "Work ends · HH:MM" : "Конец работы · ЧЧ:ММ";
                            CompactEdit {
                                text <=> root.end-time;
                                accessible-label: parent.title;
                                edited => {
                                    root.edited();
                                }
                            }
                        }
                        Field {
                            title: root.english ? "Break interval · minutes" : "Перерыв каждые · минут";
                            CompactSpinBox {
                                accessible-label: parent.title;
                                minimum:5;
                                maximum:720;
                                value <=> root.break-minutes;
                                edited => {
                                    root.edited();
                                }
                            }
                        }
                        Toggle {
                            text: root.english ? "Meal reminders" : "Напоминания о еде";
                            checked <=> root.meals;
                            toggled => {
                                root.edited();
                            }
                        }
                        Field {
                            title: root.english ? "Breakfast · HH:MM" : "Завтрак · ЧЧ:ММ";
                            CompactEdit {
                                accessible-label: parent.title;
                                text <=> root.breakfast;
                                edited => {
                                    root.edited();
                                }
                            }
                        }
                        Field {
                            title: root.english ? "Lunch · HH:MM" : "Обед · ЧЧ:ММ";
                            CompactEdit {
                                accessible-label: parent.title;
                                text <=> root.lunch;
                                edited => {
                                    root.edited();
                                }
                            }
                        }
                        Field {
                            title: root.english ? "Dinner · HH:MM" : "Ужин · ЧЧ:ММ";
                            CompactEdit {
                                accessible-label: parent.title;
                                text <=> root.dinner;
                                edited => {
                                    root.edited();
                                }
                            }
                        }
                        Toggle {
                            text: root.english ? "Stretch after breakfast, including weekends" : "Разминка после завтрака, включая выходные";
                            checked <=> root.stretch;
                            toggled => {
                                root.edited();
                            }
                        }
                        Field {
                            title: root.english ? "Stretch delay · minutes" : "Разминка через · минут";
                            CompactSpinBox {
                                accessible-label: parent.title;
                                minimum:1;
                                maximum:1440;
                                value <=> root.stretch-minutes;
                                edited => {
                                    root.edited();
                                }
                            }
                        }
                    }
                    if root.setup-step == 2 : VerticalLayout {
                        spacing: 12px;
                        Label {
                            height: 70px;
                            wrap: word-wrap;
                            text: root.english ? "Take a little break. Stand up and stretch. This is a preview: it does not confirm breakfast or start a timer." : "Сделай небольшую паузу. Встань и потянись. Это пример: он не отмечает завтрак и не запускает таймер.";
                        }
                        Field {
                            title: root.english ? "Audio output" : "Устройство озвучки";
                            CompactComboBox {
                                model: root.audio-device-names;
                                current-index <=> root.audio-device-index;
                                accessible-label: parent.title;
                                selected => {
                                    root.audio-device-id=root.audio-device-ids[root.audio-device-index];
                                    root.edited();
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            ActionButton {
                                text: root.english ? "Refresh outputs" : "Обновить устройства";
                                clicked => {
                                    root.refresh-audio();
                                }
                            }
                            ActionButton {
                                text: root.english ? "Chime" : "Сигнал";
                                clicked => {
                                    root.test-audio(0);
                                }
                            }
                            ActionButton {
                                text: root.english ? "Voice" : "Голос";
                                clicked => {
                                    root.test-audio(1);
                                }
                            }
                            ActionButton {
                                text: root.english ? "Stop" : "Стоп";
                                clicked => {
                                    root.silence();
                                }
                            }
                        }
                        Label {
                            height: 55px;
                            wrap: word-wrap;
                            text: root.audio-test-status;
                            color: Colors.muted;
                        }
                        Label {
                            height: 60px;
                            wrap: word-wrap;
                            color: Colors.muted;
                            text: root.english ? "If a pinned output disappears, speech stops. Kavychka will not move it to another output. Voice preview uses an installed Windows voice." : "Если закреплённое устройство исчезнет, речь остановится без перехода на другое. Для пробы используется установленный голос Windows.";
                        }
                    }
                    if root.setup-step == 3 : VerticalLayout {
                        spacing: 18px;
                        Label {
                            height: 100px;
                            wrap: word-wrap;
                            color: Colors.muted;
                            text: root.english ? "Do not disturb: Windows does not reliably expose its switch to this app. Use Pause when you need guaranteed silence. Reported notification restrictions are respected by default." : "«Не беспокоить»: Windows не всегда передаёт приложению этот переключатель. Если нужна тишина, включай паузу. Полученные от Windows запреты учитываются по умолчанию.";
                        }
                        Label {
                            height: 120px;
                            wrap: word-wrap;
                            text: root.english ? "You can start without downloads. Built-in phrases, reminders and Windows speech already work offline. Local text and voice models are optional; choose them later and install only what you need." : "Можно начать без загрузок. Встроенные фразы, напоминания и голос Windows уже работают офлайн. Модели текста и голоса необязательны: выбери их позже и установи только нужные.";
                        }
                        Label {
                            height: 80px;
                            wrap: word-wrap;
                            color: Colors.muted;
                            text: root.english ? "Closing settings leaves Kavychka in the tray. Exit ends reminders. All settings can be changed later." : "Закрытие настроек оставляет Кавычку в трее. «Выйти» завершает напоминания. Все настройки можно изменить позже.";
                        }
                    }
                }
            }
            Label {
                height: 42px;
                wrap: word-wrap;
                text: root.status;
                color: root.failed ? (Colors.dark ? #ffaaa3 : #aa2727) : Colors.muted;
            }
            HorizontalLayout {
                height: 36px;
                spacing: 12px;
                ActionButton {
                    text: root.english ? "Back" : "Назад";
                    enabled: root.setup-step > 0 && !root.busy;
                    clicked => {
                        root.setup-next(-1);
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                if root.setup-step < 3 : ActionButton {
                    text: root.english ? "Next" : "Далее";
                    primary: true;
                    enabled: !root.busy && !root.data-operation-active;
                    clicked => {
                        root.setup-next(1);
                    }
                }
                if root.setup-step == 3 : ActionButton {
                    text: root.english ? "Choose models" : "Выбрать модели";
                    enabled: !root.busy;
                    clicked => {
                        root.finish-setup(true);
                    }
                }
                if root.setup-step == 3 : ActionButton {
                    text: root.english ? "Start without downloads" : "Начать без загрузок";
                    primary: true;
                    enabled: !root.busy;
                    clicked => {
                        root.finish-setup(false);
                    }
                }
            }
        }
    }

    Rectangle {
        x:root.content-x; y:80px; width:root.content-width; height:parent.height - 142px;
        visible:root.page==2;
        FocusScope {
            enabled:root.ready && !root.busy && !root.confirm-close && !root.onboarding && !root.data-operation-active;
            width:parent.width; height:parent.height;
            key-pressed(event)=>{
                if(event.modifiers.control && (event.text=="a" || event.text=="A")) {root.select-all-library(true);return accept;}
                return reject;
            }
            VerticalLayout {
                padding:0px; spacing:8px;
                Card {
                    VerticalLayout {
                        padding:10px; spacing:6px;
                        HorizontalLayout {
                            spacing:6px; alignment:start; vertical-stretch:0;
                            TabButton {text:(root.english ? "Current · " : "Актуальные · ")+root.library-current-count; selected:root.library-today && !root.library-support; clicked=>{root.library-support=false;root.library-today=true;root.library-filter();}}
                            TabButton {text:(root.english ? "History · " : "История · ")+root.library-history-count; selected:!root.library-today && !root.library-support; clicked=>{root.library-support=false;root.library-today=false;root.library-filter();}}
                            TabButton {text:(root.english ? "Support · " : "Поддержка · ")+root.support-texts.length;selected:root.library-support;clicked=>{root.library-support=true;root.library-filter();}}
                        }
                        HorizontalLayout {
                            spacing:6px; alignment:start; vertical-stretch:0;
                            if root.library-today && !root.library-support : IconButton {icon:@image-url("icons/prepare.svg");tip:root.english ? "Prepare missing phrases for today" : "Подготовить недостающие фразы на сегодня";enabled:!root.generation-running && !root.dirty;clicked=>{root.prepare-day();}}
                            if root.library-today && !root.library-support : IconButton {icon:@image-url("icons/plus.svg");tip:root.english ? "Generate a new batch…" : "Создать новую партию…";clicked=>{root.library-controls=true;}}
                            if root.library-today && !root.library-support : IconButton {icon:@image-url("icons/download.svg");tip:root.english ? "Export selected phrases" : "Экспорт выделенных фраз";enabled:root.library-selected-count>0 && !root.generation-running && !root.dirty;clicked=>{root.library-action("export");}}
                            if root.library-today && !root.library-support : IconButton {icon:@image-url("icons/stop.svg");tip:root.english ? "Cancel generation" : "Отменить генерацию";enabled:root.generation-running;clicked=>{root.cancel-generation();}}
                            Rectangle {horizontal-stretch:1;}
                            if !root.library-support : IconButton {icon:@image-url("icons/previous.svg");tip:root.english ? "Previous page" : "Предыдущая страница";enabled:root.library-page-index>0;clicked=>{root.library-page(-1);}}
                            Label {text:root.library-support ? (root.english ? "Text only" : "Без озвучки") : root.library-page-caption;min-width:70px;font-size:12px;vertical-alignment:center;}
                            if !root.library-support : IconButton {icon:@image-url("icons/next.svg");tip:root.english ? "Next page" : "Следующая страница";enabled:root.library-has-next;clicked=>{root.library-page(1);}}
                            if !root.library-support : IconButton {icon:@image-url("icons/info.svg");tip:root.english ? "● Available today; ✓ Played; ◷ Used without confirmed speech; × Excluded; ? Review; ! Missing audio/error; ■ Stopped; … Speech requested; — History" : "● Доступна сегодня; ✓ Озвучена; ◷ Использована без подтверждённой озвучки; × Исключена; ? На отбор; ! Нет записи/ошибка; ■ Остановлена; … Озвучка начата; — История";}
                        }
                        HorizontalLayout {
                            spacing:6px; alignment:start; vertical-stretch:0;
                            CheckBox {text:root.english ? "All" : "Все";checked:root.library-all-selected;accessible-label:root.english ? "Select all phrases in this category, across pages" : "Выбрать все фразы категории на всех страницах";toggled=>{self.focus();root.select-all-library(self.checked);}}
                            Label {text:(root.english ? "Selected: " : "Выбрано: ")+root.library-selected-count;min-width:100px;vertical-alignment:center;font-size:12px;}
                            if root.library-today && !root.library-support : IconButton {icon:@image-url("icons/play.svg");tip:root.english ? "Listen: select one phrase" : "Прослушать: выбери одну фразу";enabled:root.library-selected-count==1;clicked=>{root.library-action("play");}}
                            if root.library-today && !root.library-support : IconButton {icon:@image-url("icons/check.svg");tip:root.english ? "Keep selected for reminders" : "Оставить выделенные для напоминаний";enabled:root.library-selected-count>0 && !root.generation-running;clicked=>{root.library-action("keep");}}
                            if root.library-today && !root.library-support : IconButton {icon:@image-url("icons/exclude.svg");tip:root.english ? "Exclude selected from reminders" : "Исключить выделенные из напоминаний";enabled:root.library-selected-count>0 && !root.generation-running;clicked=>{root.library-action("exclude");}}
                            if root.library-today && !root.library-support : IconButton {icon:@image-url("icons/refresh.svg");tip:root.english ? "Regenerate speech for selected phrases" : "Переозвучить выделенные фразы";enabled:root.library-selected-count>0 && !root.generation-running && !root.dirty;clicked=>{root.library-action("speech");}}
                            if root.library-today && !root.library-support : IconButton {icon:@image-url("icons/stop.svg");tip:root.english ? "Stop speech" : "Остановить речь";clicked=>{root.silence();}}
                            Rectangle {horizontal-stretch:1;}
                            IconButton {icon:@image-url("icons/trash.svg");tip:root.english ? "Delete selected…" : "Удалить выделенные…";enabled:root.library-selected-count>0 && !root.generation-running;clicked=>{root.library-delete-selection=root.library-selection;root.confirm-library-delete=true;}}
                        }
                    }
                }
                library-list := ScrollView {
                    vertical-stretch:1; content-width:self.width; content-y<=>root.library-scroll-y;
                    accessible-role:list;
                    accessible-label:root.english ? "Phrase list" : "Список фраз";
                    VerticalLayout {
                        spacing:1px; padding:0px;
                        for item in (root.library-support ? root.support-items : root.library-items) : Rectangle {
                            height:max(root.library-support ? 56px : 72px,phrase.preferred-height + (root.library-support ? 20px : 36px));
                            vertical-stretch:0;background:item.selected ? Colors.soft : Colors.surface;
                            TouchArea {x:40px;y:0px;width:parent.width - 76px;height:parent.height;clicked=>{root.toggle-library-item(item.identifier);}}
                            CheckBox {x:8px;y:8px;width:28px;height:30px;checked:item.selected;accessible-label:(root.english ? "Select phrase: " : "Выбрать фразу: ")+item.text;toggled=>{self.focus();root.toggle-library-item(item.identifier);}}
                            if !root.library-support : Label {x:42px;y:5px;height:18px;width:parent.width - 52px;font-size:11px;color:Colors.muted;text:item.caption;}
                            phrase := Text {x:42px;y:root.library-support ? 10px : 27px;width:max(80px,parent.width - 82px);height:self.preferred-height;text:item.text;color:Colors.ink;font-size:13px;wrap:word-wrap;}
                            if !root.library-support : Rectangle {x:parent.width - 32px;y:27px;width:24px;height:24px;accessible-role:text;accessible-label:item.state-hint;Text {x:0px;y:0px;width:parent.width;height:parent.height;text:item.state;color:Colors.accent;horizontal-alignment:center;vertical-alignment:center;font-size:18px;}Tooltip {text:@markdown("\{item.state-hint}");}}
                            Rectangle {x:8px;y:parent.height - 1px;height:1px;width:parent.width - 16px;background:Colors.line;}
                        }
                        if (root.library-support ? root.support-items.length : root.library-items.length)==0 : Hint {text:root.english ? "No phrases in this list." : "В этом списке пока нет фраз.";}
                        Rectangle {vertical-stretch:1;min-height:0px;}
                    }
                }
            }
        }
    }
    changed library-controls=>{if(root.library-controls){batch-popup.show();}else{batch-popup.close();}}
    batch-popup := PopupWindow {
        x:root.content-x;y:80px;width:root.content-width;height:min(520px,root.height - 100px);close-policy:no-auto-close;
        Rectangle {
            background:Colors.surface;
            VerticalLayout {
                padding:10px;spacing:8px;
                HorizontalLayout {Label {text:root.english ? "New phrase batch" : "Новая партия фраз";font-weight:600;}IconButton {icon:@image-url("icons/exclude.svg");tip:root.english ? "Close" : "Закрыть";clicked=>{root.library-controls=false;}}}
                ScrollView {content-width:self.width;vertical-stretch:1;
                    VerticalLayout {
            Card {
                VerticalLayout {
                    padding:16px;
                    spacing:8px;
                    SectionTitle {
                        text:root.english ? "New phrase batch" : "Новая партия фраз";
                    }
                    Field {
                        title:root.english ? "Phrase count" : "Всего фраз";
                        control-width:110px;
                        CompactSpinBox {
                            accessible-label:parent.title;
                            minimum:1;
                            maximum:100;
                            value<=>root.batch-count;
                            edited=>{
                                root.edited();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing:8px;
                        alignment:start;
                        min-height:32px;
                        vertical-stretch:0;
                        ChoiceToggle {
                            text:root.english ? "Breaks" : "Перерывы";
                            checked<=>root.category-break;
                            toggled=>{
                                root.edited();
                            }
                        }
                        ChoiceToggle {
                            text:root.english ? "Breakfast" : "Завтрак";
                            checked<=>root.category-breakfast;
                            toggled=>{
                                root.edited();
                            }
                        }
                        ChoiceToggle {
                            text:root.english ? "Lunch" : "Обед";
                            checked<=>root.category-lunch;
                            toggled=>{
                                root.edited();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing:8px;
                        alignment:start;
                        min-height:32px;
                        vertical-stretch:0;
                        ChoiceToggle {
                            text:root.english ? "Dinner" : "Ужин";
                            checked<=>root.category-dinner;
                            toggled=>{
                                root.edited();
                            }
                        }
                        ChoiceToggle {
                            text:root.english ? "Stretch" : "Разминка";
                            checked<=>root.category-exercise;
                            toggled=>{
                                root.edited();
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing:8px;
                        alignment:start;
                        min-height:32px;
                        vertical-stretch:0;
                        ActionButton {
                            text:root.english ? "Generate batch" : "Создать партию";
                            enabled:!root.generation-running && !root.dirty;
                            primary:true;
                            clicked=>{
                                root.generate-batch();
                            }
                        }
                    }
                    if root.on-battery : ActionButton {
                        text:root.english ? "Generate on battery once" : "Создать от батареи один раз";
                        enabled:!root.generation-running && !root.dirty;
                        clicked=>{
                            root.generate-on-battery();
                        }
                    }
                    Hint {
                        text:root.english ? "Save changes before starting. Prepare day follows the schedule." : "Сохрани настройки перед запуском. «Подготовить день» учитывает расписание.";
                    }
                }
            }

                    }
                }
            }
        }
    }

    changed delete-phrase-id=>{
        if(root.delete-phrase-id!=""){delete-popup.show();}else{delete-popup.close();}
    }
    delete-popup := PopupWindow {
        x:0px; y:0px; width:root.width; height:root.height; close-policy:no-auto-close;
        RemovePhraseDialog {
            width:root.width; height:root.height; english:root.english;
            cancel=>{root.delete-phrase-id="";}
            confirm=>{root.hide-phrase(root.delete-phrase-id);root.delete-phrase-id="";}
        }
    }
    changed confirm-library-delete=>{if(root.confirm-library-delete){bulk-delete-popup.show();}else{bulk-delete-popup.close();}}
    bulk-delete-popup := PopupWindow {
        x:0px;y:0px;width:root.width;height:root.height;close-policy:no-auto-close;
        RemovePhraseDialog {width:root.width;height:root.height;english:root.english;count:root.library-selected-count;
            cancel=>{root.confirm-library-delete=false;}
            confirm=>{if(root.library-selection==root.library-delete-selection){root.library-action("delete");}root.confirm-library-delete=false;}
        }
    }
    unsaved-popup := PopupWindow {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        close-policy: no-auto-close;
        CloseDialog {
            width: root.width;
            height: root.height;
            english: root.english;
            background-close: root.close-to-background;
            cancel => {
                root.confirm-close=false;
            }
            discard => {
                root.discard-and-quit();
            }
            save => {
                root.save-and-quit();
            }
        }
    }
}
