import { Button, CheckBox, ComboBox, LineEdit, TextEdit, SpinBox, ScrollView, Palette, AboutSlint } from "std-widgets.slint";
export { PetWindow, NoticeWindow, AppTray } from "companion.slint";
export struct LibraryItem { identifier:string, text:string, caption:string, kept:bool, excluded:bool, has-audio:bool }
export struct PendingItem { identifier:string, text:string, caption:string }
export component RemovalWindow inherits Window {
    title:root.english ? "Kavychka · removal" : "Кавычка · удаление";preferred-width:760px;preferred-height:620px;min-width:660px;min-height:520px;
    in property <bool> english;
    in property <bool> dark;in property <bool> busy;in property <bool> removing;in property <bool> reviewed;in property <bool> done;in property <string> summary;
    in-out property <bool> full;in-out property <bool> confirmed;
    callback preview;callback remove;callback dismiss;
    background:Colors.canvas;
    init=>{Colors.dark=root.dark;Palette.color-scheme=root.dark ? ColorScheme.dark : ColorScheme.light;}
    VerticalLayout {padding:28px;spacing:16px;
        Text {text:root.english ? "Remove Kavychka" : "Удаление Кавычки";font-size:24px;font-weight:600;color:Colors.ink;}
        CheckBox {text:root.english ? "Also remove ALL data and models" : "Удалить также ВСЕ данные и модели";checked <=> root.full;enabled:!root.busy && !root.done;toggled=>{root.confirmed=false;root.preview();}}
        TextEdit {text:root.summary;read-only:true;vertical-stretch:1;accessible-label:root.english ? "Removal contents" : "Точный состав удаления";}
        CheckBox {text:root.english ? "I reviewed and confirm removal" : "Я проверил состав и подтверждаю удаление";checked <=> root.confirmed;enabled:root.reviewed && !root.busy && !root.done;}
        HorizontalLayout {spacing:8px;Button{text:root.english ? "Review again" : "Проверить ещё раз";enabled:!root.busy && !root.done;clicked=>{root.confirmed=false;root.preview();}}Rectangle{horizontal-stretch:1;}Button{text:root.english ? "Remove" : "Удалить";enabled:root.reviewed && root.confirmed && !root.busy && !root.done;clicked=>{root.remove();}}Button{text:root.done ? (root.english ? "Close" : "Закрыть") : (root.english ? "Cancel" : "Отмена");enabled:!root.busy || !root.removing;clicked=>{root.dismiss();}}}
    }
}
export component TransferWindow inherits Window {
    title: "Кавычка · перенос хранилища / Kavychka storage transfer";
    preferred-width: 720px; preferred-height: 440px; min-width: 600px; min-height: 380px;
    in property <bool> dark;
    in property <bool> done;
    in property <string> destination;
    in property <string> status;
    callback cancel;
    callback resume;
    background: Colors.canvas;
    init => { Colors.dark=root.dark; Palette.color-scheme=root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark => { Colors.dark=root.dark; Palette.color-scheme=root.dark ? ColorScheme.dark : ColorScheme.light; }
    VerticalLayout {padding:28px;spacing:16px;
        Text {text:"Перенос общей папки / Moving shared storage";font-size:23px;font-weight:600;color:Colors.ink;wrap:word-wrap;}
        Text {text:"Данные, модели и среды копируются без скачивания. Исходная папка сохраняется. При отмене продолжим с прежними данными. / Data, models and runtimes are copied without downloads. Source retained; cancellation keeps the previous data active.";color:Colors.muted;wrap:word-wrap;}
        LineEdit {text:root.destination;read-only:true;accessible-label:"Папка назначения / Destination";}
        TextEdit {text:root.status;read-only:true;accessible-label:"Ход переноса / Transfer progress";vertical-stretch:1;}
        HorizontalLayout {Rectangle {horizontal-stretch:1;}
            Button {text:"Отменить / Cancel";enabled:!root.done;clicked=>{root.cancel();}}
            Button {text:"Открыть Кавычку / Open Kavychka";enabled:root.done;primary:true;clicked=>{root.resume();}}
        }
    }
}
export component SetupWindow inherits Window {
    title: "Кавычка · установка / Kavychka setup"; preferred-width: 760px; preferred-height: 700px;
    min-width: 680px; min-height: 600px;
    in property <bool> dark;
    in property <string> version;
    in-out property <string> program-path;
    in-out property <string> data-path;
    in-out property <string> legacy-path;
    in-out property <bool> integrations: true;
    in property <bool> portable;
    in-out property <bool> busy;
    in-out property <bool> done;
    in-out property <int> recovery-limit-mb: 2000;
    in-out property <bool> budget-edited;
    in-out property <string> status;
    callback install;
    callback open;
    init => { Colors.dark = root.dark; Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark => { Colors.dark = root.dark; Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    background: Colors.canvas;
    VerticalLayout { padding: 32px; spacing: 16px;
        Text { text: "Кавычка / Kavychka " + root.version; font-size: 26px; font-weight: 600; color: Colors.ink; }
        Text { text: "Установка для текущего пользователя / Install for the current user"; color: Colors.muted; }
        ScrollView { VerticalLayout { spacing: 12px; padding-right: 12px;
        Text { text: "Программа / Program"; color: Colors.ink; }
        LineEdit { enabled: !root.busy && !root.done && !root.portable; text <=> root.program-path; }
        Text { text: "Общее хранилище / Shared models and data"; color: Colors.ink; }
        LineEdit { enabled: !root.busy && !root.done && !root.portable; text <=> root.data-path; }
        Text { text: "Прежняя библиотека · необязательно / Previous library · optional"; color: Colors.ink; }
        LineEdit { enabled: !root.busy && !root.done && !root.portable; text <=> root.legacy-path; }
        Text { text: "Лимит резервов и карантина · МБ / Recovery budget · MB"; color: Colors.ink; }
        SpinBox { enabled: !root.busy && !root.done; minimum: 100; maximum: 100000; value <=> root.recovery-limit-mb; edited => { root.budget-edited=true; } }
        Text { height: 85px; wrap: word-wrap; color: Colors.muted; text: "Модели и записи сохраняются отдельно от версии приложения. Закрой работающую Кавычку перед установкой. Базовый режим работает без Python и загрузки моделей.\nModels and recordings are separate from app versions. Close Kavychka before installing. Basic reminders need no Python or model downloads."; }
        CheckBox { enabled: !root.busy && !root.done && !root.portable; text: "Ярлык в меню Пуск / Start menu shortcut"; checked <=> root.integrations; }
        } }
        Text { height: 54px; text: root.status; wrap: word-wrap; color: Colors.ink; }
        HorizontalLayout { height: 84px; AboutSlint { height: 84px; width: 180px; } Rectangle { horizontal-stretch: 1; } Button { height: 36px; enabled: !root.busy && !root.done; text: root.busy ? "Устанавливаем… / Installing…" : "Установить / Install"; primary: true; clicked => { root.install(); } } Button { height: 36px; enabled: root.done; text: "Открыть / Open"; clicked => { root.open(); } } }
    }
}

export global Colors {
    in property <bool> dark;
    out property <color> canvas: dark ? #15171d : #f5f6fa;
    out property <color> surface: dark ? #20232c : #ffffff;
    out property <color> soft: dark ? #282d3a : #edf0fc;
    out property <color> line: dark ? #333744 : #e7e9f0;
    out property <color> ink: dark ? #f1f2f6 : #242837;
    out property <color> muted: dark ? #b1b9ca : #596579;
    out property <color> accent: dark ? #a1b0ff : #4d60bd;
}
component Label inherits Text {
    color: Colors.ink; font-family: "Segoe UI"; font-size: 14px;
    vertical-alignment: center; overflow: elide;
}
component Card inherits Rectangle {
    background: Colors.surface; border-width: 1px; border-color: Colors.line; border-radius: 16px;
}
component Nav inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> compact;
    in property <bool> tight;
    in property <bool> enabled: true;
    callback clicked;
    height: root.tight ? 32px : 44px; border-radius: 10px; background: selected ? Colors.soft : transparent;
    border-color: focus.has-focus ? Colors.accent : transparent; border-width: 2px;
    accessible-role: button; accessible-label: root.text; accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: focus;
    Tooltip { text: @markdown("\{root.text}"); }
    Image { x: 15px; y: (parent.height - 20px)/2; width: 20px; height: 20px; source: root.icon; colorize: root.selected ? Colors.accent : Colors.muted; }
    Label { visible: !root.compact; x: 48px; width: parent.width - 56px; height: parent.height; text: root.text; wrap: word-wrap; font-size: 13px; color: root.selected ? Colors.accent : Colors.muted; font-weight: root.selected ? 600 : 400; }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if (event.text == "\n" || event.text == " ") { root.clicked(); return accept; } return reject; } }
    TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
}
component Field inherits Rectangle {
    in property <string> title;
    height: 46px; background: transparent;
    Label { x: 0px; y: 0px; text: root.title; width: 180px; height: parent.height; wrap: word-wrap; }
    Rectangle { x: 192px; width: parent.width - 192px; height: parent.height; border-radius: 5px;
        border-width: 1px; border-color: Colors.dark ? #78859e : #7c879f; background: transparent;
        HorizontalLayout { padding: 1px; @children }
    }
}
component CloseDialog inherits Rectangle {
    in property <bool> english;
    in property <bool> background-close;
    callback cancel;
    callback discard;
    callback save;
    background: #00000070;
    TouchArea { }
    FocusScope {
        focus-on-tab-navigation: false;
        init => { keep.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.cancel(); return accept; }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                if (event.text == Key.Backtab || event.modifiers.shift) {
                    if (keep.has-focus) { commit.focus(); } else if (commit.has-focus) { reject-changes.focus(); } else { keep.focus(); }
                } else {
                    if (keep.has-focus) { reject-changes.focus(); } else if (reject-changes.has-focus) { commit.focus(); } else { keep.focus(); }
                }
                return accept;
            }
            return reject;
        }
        Card {
            x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
            width: min(600px,parent.width - 48px); height: 240px;
            VerticalLayout { padding: 24px; spacing: 16px;
                Label { height: 32px; text: root.english ? "Save your changes?" : "Сохранить изменения?"; font-size: 22px; font-weight: 600; }
                Label { height: 60px; wrap: word-wrap; color: Colors.muted; text: root.english ? "You have unsaved settings. Choose what to keep before closing." : "Остались несохранённые настройки. Выбери, что сохранить перед закрытием."; }
                HorizontalLayout { height: 40px; spacing: 10px;
                    keep := Button { text: root.english ? "Keep editing" : "Продолжить"; clicked => { root.cancel(); } }
                    reject-changes := Button { text: root.english ? "Discard" : "Не сохранять"; clicked => { root.discard(); } }
                    commit := Button { text: root.english ? "Save and close" : "Сохранить и закрыть"; primary: true; clicked => { root.save(); } }
                }
            }
        }
    }
}
