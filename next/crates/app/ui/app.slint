            Nav { y: root.nav-step * 2; width: parent.width; tight: root.tight; compact: root.compact; enabled: !root.confirm-close && !root.onboarding; text: root.english ? "Library" : "Библиотека"; icon: @image-url("../../design-preview/ui/library.svg"); selected: root.page == 2; clicked => { root.page = 2; root.refresh-library(); } }
            Nav { y: root.nav-step * 3; width: parent.width; tight: root.tight; compact: root.compact; enabled: !root.confirm-close && !root.onboarding; text: root.english ? "Voice and models" : "Голос и модели"; icon: @image-url("../../design-preview/ui/voice.svg"); selected: root.page == 3; clicked => { root.page = 3; root.refresh-library(); } }
            Nav { y: root.nav-step * 4; width: parent.width; tight: root.tight; compact: root.compact; enabled: !root.confirm-close && !root.onboarding; text: root.english ? "Character" : "Персонаж"; icon: @image-url("../../design-preview/ui/person.svg"); selected: root.page == 4; clicked => { root.page = 4; } }
            Nav { y: root.nav-step * 5; width: parent.width; tight: root.tight; compact: root.compact; enabled: !root.confirm-close && !root.onboarding; text: root.english ? "Settings" : "Настройки"; icon: @image-url("../../design-preview/ui/settings.svg"); selected: root.page == 5; clicked => { root.page = 5; } }
            Nav { y: root.nav-step * 6; width: parent.width; tight: root.tight; compact: root.compact; enabled: !root.confirm-close && !root.onboarding; text: root.english ? "Storage" : "Хранилище"; icon: @image-url("../../design-preview/ui/library.svg"); selected: root.page == 6; clicked => { root.page = 6; } }
            Nav { y: root.nav-step * 7; width: parent.width; tight: root.tight; compact: root.compact; enabled: !root.confirm-close && !root.onboarding; text: root.english ? "Help and updates" : "Помощь и обновления"; icon: @image-url("../../design-preview/ui/settings.svg"); selected: root.page == 7; clicked => { root.page = 7; } }
        }
        Label { visible: !root.compact; x: 26px; y: parent.height - 100px; width: 178px; height: 32px; text: root.english ? "Development preview" : "Версия для разработки"; font-size: 12px; color: Colors.accent; }
        Button { x: root.compact ? 8px : 25px; y: parent.height - 60px; width: root.sidebar - (root.compact ? 16px : 51px); enabled: !root.confirm-close; text: root.compact ? "×" : (root.english ? "Exit" : "Выйти"); accessible-label: root.english ? "Exit application" : "Выйти из приложения"; clicked => { root.quit(); } }
    }
    Label { x: root.content-x; y: 30px; width: root.content-width; height: 25px; text: root.background-running ? root.runtime-status : (root.english ? "Isolated storage · settings-only check" : "Отдельное хранилище · проверка настроек"); color: Colors.muted; font-size: 13px; }
    Label { x: root.content-x; y: 85px; width: root.content-width; height: 43px; font-size: root.compact ? 23px : 28px; font-weight: 650;
        text: root.page == 0 ? (root.english ? "Make room for a little break." : "Сегодня можно чуть спокойнее.") : root.page == 1 ? (root.english ? "Your schedule" : "Твоё расписание") : root.page == 2 ? (root.english ? "Phrase library" : "Библиотека фраз") : root.page == 3 ? (root.english ? "Voice and models" : "Голос и модели") : root.page == 4 ? (root.english ? "Character" : "Персонаж") : root.page == 6 ? (root.english ? "Storage" : "Хранилище") : root.page == 7 ? (root.english ? "Help and updates" : "Помощь и обновления") : (root.english ? "Settings" : "Настройки");
    }
    main-scroll := ScrollView {
        content-y <=> root.scroll-y;
        x: root.content-x; y: 155px; width: root.content-width; height: parent.height - 269px;
        content-width: self.width;
        enabled: root.ready && !root.busy && !root.confirm-close && !root.onboarding && (!root.data-operation-active || root.page == 6);
        VerticalLayout { padding: 0px; spacing: 16px;
            if root.page == 0 : Card {
                height: root.background-running ? 365px : 250px;
                Image { x: 30px; y: 30px; width: 100px; height: 100px; source: @image-url("../../design-preview/ui/quote.svg"); }
                Label { x: 164px; y: 25px; width: parent.width - 190px; height: 36px; font-size: 21px; font-weight: 600; text: root.background-running ? root.next-reminder : (root.english ? "A new home for Kavychka" : "Новый дом для Кавычки"); }
                Label { x: 164px; y: 75px; width: parent.width - 190px; height: 95px; wrap: word-wrap; text: root.background-running ? (root.pending-text != "" ? root.pending-text : (root.english ? "The tray and companion keep running when you close settings. Your phrase library, local models and voice choices are available in the sidebar." : "Трей и маскот продолжают работать после закрытия настроек. Библиотека фраз, локальные модели и выбор голоса доступны в разделах слева.")) : (root.english ? "Schedule, theme and activity settings already save here. Your current app, models and recordings remain in their own storage." : "Здесь уже сохраняются расписание, тема и правила активности. Текущая Кавычка, модели и записи остаются в своём хранилище."); color: Colors.muted; }
                if root.background-running : VerticalLayout { x: 24px; y: 186px; width: parent.width - 48px; height: 156px; spacing: 10px;
                    HorizontalLayout { spacing: 10px;
                        Button { text: root.english ? "Confirm reminder" : "Подтвердить сообщение"; enabled: root.pending-key != ""; primary: true; clicked => { root.confirm-reminder(root.pending-key); } }
                        Button { text: root.english ? "Stretch now" : "Разминка сейчас"; clicked => { root.stretch-now(); } }
                        Button { text: root.english ? "I had breakfast" : "Отметить завтрак"; enabled: !root.breakfast-done; clicked => { root.mark-breakfast(); } }
                    }
                    HorizontalLayout { spacing: 10px;
                        SpinBox { minimum: 1; maximum: 1440; value <=> root.pause-minutes-value; accessible-label: root.english ? "Pause duration in minutes" : "Длительность паузы в минутах"; }
                        Button { text: root.english ? "Pause · minutes" : "Пауза · минут"; clicked => { root.pause-minutes(root.pause-minutes-value); } }
                        Button { text: root.english ? "Until tomorrow" : "До завтра"; clicked => { root.pause-minutes(-1); } }
                        Button { text: root.english ? "Resume" : "Продолжить"; clicked => { root.pause-minutes(0); } }
                    }
                    HorizontalLayout { spacing: 10px;
                        Button { text: root.english ? "Pending messages" : "Неподтверждённые"; clicked => { root.review-pending(); } }
                        Button { text: root.english ? "Stop audio" : "Остановить звук"; clicked => { root.silence(); } }
                        Button { text: root.english ? "Schedule" : "Расписание"; clicked => { root.page = 1; } }
                    }
                    Label { height: 26px; text: root.pause-caption; color: Colors.muted; }
                }
                if !root.background-running : Button { x: 164px; y: 183px; width: 190px; text: root.english ? "Set my schedule" : "Настроить расписание"; clicked => { root.page = 1; } }
            }
            if root.page == 0 && root.archive-total>0 : Card {vertical-stretch:0;
                VerticalLayout {padding:20px;spacing:10px;
                    Label {height:32px;font-size:18px;text:root.english ? "Earlier pending messages · "+root.archive-total : "Прежние неподтверждённые · "+root.archive-total;}
                    Label {height:50px;wrap:word-wrap;color:Colors.muted;text:root.english ? "These messages are kept without restarting old reminders. Confirming here only closes the old message." : "Сообщения сохранены без повторного запуска старых напоминаний. Подтверждение здесь только закрывает прежнее сообщение.";}
                    for notice in root.archived-notices : VerticalLayout {spacing:6px;
                        Label {height:24px;text:notice.caption;color:Colors.muted;}
                        Text {text:notice.text;wrap:word-wrap;color:Colors.ink;}
                        Button {text:root.english ? "Confirm old message" : "Подтвердить прежнее";clicked=>{root.confirm-archived(notice.identifier);}}
                    }
                    HorizontalLayout {spacing:8px;
                        Button {text:root.english ? "Previous" : "Назад";enabled:root.archive-page-index>0;clicked=>{root.archive-page(-1);}}
                        Label {text:(root.english ? "Page " : "Страница ")+(root.archive-page-index+1);}
                        Button {text:root.english ? "Next" : "Далее";enabled:root.archive-has-next;clicked=>{root.archive-page(1);}}
                    }
                }
            }
            if root.page == 1 : Card { vertical-stretch: 0;
                VerticalLayout { padding: 24px; spacing: 14px;
                    Label { text: root.english ? "Work days" : "Рабочие дни"; height: 28px; font-size: 18px; font-weight: 600; }
                    HorizontalLayout { spacing: 10px; height: 32px;
                        CheckBox { text: root.english ? "Mo" : "Пн"; checked <=> root.monday; toggled => { root.edited(); } }
                        CheckBox { text: root.english ? "Tu" : "Вт"; checked <=> root.tuesday; toggled => { root.edited(); } }
                        CheckBox { text: root.english ? "We" : "Ср"; checked <=> root.wednesday; toggled => { root.edited(); } }
                        CheckBox { text: root.english ? "Th" : "Чт"; checked <=> root.thursday; toggled => { root.edited(); } }
                        CheckBox { text: root.english ? "Fr" : "Пт"; checked <=> root.friday; toggled => { root.edited(); } }
                        CheckBox { text: root.english ? "Sa" : "Сб"; checked <=> root.saturday; toggled => { root.edited(); } }
                        CheckBox { text: root.english ? "Su" : "Вс"; checked <=> root.sunday; toggled => { root.edited(); } }
                    }
                    Field { title: root.english ? "Work starts · HH:MM" : "Начало работы · ЧЧ:ММ"; LineEdit { text <=> root.start-time; accessible-label: parent.title; edited => { root.edited(); } } }
                    Field { title: root.english ? "Work ends · HH:MM" : "Конец работы · ЧЧ:ММ"; LineEdit { text <=> root.end-time; accessible-label: parent.title; edited => { root.edited(); } } }
                    Field { title: root.english ? "Break interval · minutes" : "Перерыв каждые · минут"; SpinBox { minimum: 5; maximum: 720; value <=> root.break-minutes; accessible-label: parent.title; edited => { root.edited(); } } }
                    CheckBox { text: root.english ? "Meal reminders on work days" : "Напоминать о еде в рабочие дни"; checked <=> root.meals; toggled => { root.edited(); } }
                    Field { title: root.english ? "Breakfast · HH:MM" : "Завтрак · ЧЧ:ММ"; LineEdit { enabled: root.meals; text <=> root.breakfast; accessible-label: parent.title; edited => { root.edited(); } } }
                    Field { title: root.english ? "Lunch · HH:MM" : "Обед · ЧЧ:ММ"; LineEdit { enabled: root.meals; text <=> root.lunch; accessible-label: parent.title; edited => { root.edited(); } } }
                    Field { title: root.english ? "Dinner · HH:MM" : "Ужин · ЧЧ:ММ"; LineEdit { enabled: root.meals; text <=> root.dinner; accessible-label: parent.title; edited => { root.edited(); } } }
                    CheckBox { text: root.english ? "Stretch after confirming breakfast" : "Разминка после отметки завтрака"; checked <=> root.stretch; toggled => { root.edited(); } }
                    Field { title: root.english ? "Stretch delay · minutes" : "Через сколько · минут"; SpinBox { enabled: root.stretch; minimum: 1; maximum: 1440; value <=> root.stretch-minutes; accessible-label: parent.title; edited => { root.edited(); } } }
                    Label { text: root.english ? "Stretching is independent of work days, including weekends. Confirm breakfast from Today or the tray to start its timer." : "Разминка не зависит от рабочих дней, включая выходные. Отметь завтрак на экране «Сегодня» или в трее, чтобы запустить таймер."; height: 65px; wrap: word-wrap; color: Colors.muted; }
                }
            }
            if root.page == 5 : Card { vertical-stretch: 0;
                VerticalLayout { padding: 24px; spacing: 14px;
                    Field { title: root.english ? "Appearance" : "Оформление"; ComboBox { model: root.english ? ["Follow system", "Light", "Dark"] : ["Как в системе", "Светлое", "Тёмное"]; current-index <=> root.theme-index; accessible-label: parent.title; selected => { root.edited(); } } }
                    Field { title: root.english ? "Interface language" : "Язык интерфейса"; ComboBox { model: ["Русский", "English"]; current-index <=> root.language-index; accessible-label: parent.title; selected => { root.edited(); } } }
                    Field { title: root.english ? "Speech language" : "Язык озвучки"; ComboBox { model: ["Русский", "English"]; current-index <=> root.speech-index; accessible-label: parent.title; selected => { root.edited(); } } }
                    Field { title: root.english ? "Your name · optional" : "Твоё имя · необязательно"; LineEdit { text <=> root.user-name; accessible-label: parent.title; edited => { root.edited(); } } }
                    Field { title: root.english ? "Address me as" : "Обращаться ко мне"; ComboBox { model: root.english ? ["Neutral", "Feminine", "Masculine"] : ["Нейтрально", "В женском роде", "В мужском роде"]; current-index <=> root.address-index; accessible-label: parent.title; selected => { root.edited(); } } }

                    Field { title: root.english ? "Time zone" : "Часовой пояс"; ComboBox { accessible-label: parent.title; model: root.time-zone-names; current-index <=> root.time-zone-index; selected => { root.time-zone=root.time-zone-ids[root.time-zone-index]; root.edited(); } } }
                    CheckBox { text: root.english ? "Start at sign-in" : "Запускать при входе в Windows"; checked <=> root.run-at-login; toggled => { root.edited(); } }
                    CheckBox { text: root.english ? "Check updates automatically" : "Проверять обновления автоматически"; checked <=> root.automatic-updates; toggled => { root.edited(); } }
                    CheckBox { text: root.english ? "Defer generation in fullscreen apps" : "Откладывать генерацию в полноэкранных приложениях"; checked <=> root.generation-fullscreen; toggled => { root.edited(); } }
                    Label { text: root.english ? "Rest and activity" : "Отдых и активность"; height: 32px; font-size: 18px; font-weight: 600; }
                    Field { title: root.english ? "Inactivity for rest · minutes" : "Неактивность для отдыха · минут"; SpinBox { minimum: 1; maximum: 120; value <=> root.idle-minutes; accessible-label: parent.title; edited => { root.edited(); } } }
                    Field { title: root.english ? "Ignore incidental clicks" : "Не учитывать случайных кликов"; SpinBox { minimum: 0; maximum: 100; value <=> root.allowed-clicks; accessible-label: parent.title; edited => { root.edited(); } } }
                    Field { title: root.english ? "Repeat interval · minutes" : "Повторять через · минут"; SpinBox { minimum: 1; maximum: 120; value <=> root.repeat-minutes; accessible-label: parent.title; edited => { root.edited(); } } }
                    CheckBox { text: root.english ? "Trust the confirmation without checking rest" : "Доверять отметке без проверки отдыха"; checked <=> root.trust-confirmation; toggled => { root.edited(); } }
                    Label { text: root.english ? "Mouse and keyboard activity is reduced to counts, motion and timing. Typed text is never recorded. Confirmation hides a break message; actual rest ends its repeats." : "Активность мыши и клавиатуры учитывается по счётчикам, движению и времени. Содержимое ввода не записывается. Отметка скрывает перерыв; настоящий отдых прекращает повторы."; height: 66px; wrap: word-wrap; color: Colors.muted; }
                    Field { title: root.english ? "Break repeats" : "Повторов перерыва"; SpinBox { accessible-label: parent.title; minimum: 0; maximum: 20; value <=> root.break-repeats; edited => { root.edited(); } } }
                    Field { title: root.english ? "Stretch repeats" : "Повторов разминки"; SpinBox { accessible-label: parent.title; minimum: 0; maximum: 20; value <=> root.exercise-repeats; edited => { root.edited(); } } }
                    Field { title: root.english ? "Meal repeats" : "Повторов еды"; SpinBox { accessible-label: parent.title; minimum: 0; maximum: 20; value <=> root.meal-repeats; edited => { root.edited(); } } }
                    Field { title: root.english ? "Reminder audio" : "Звук напоминаний"; ComboBox { accessible-label: parent.title; model: root.english ? ["Chime and voice", "Chime only", "Voice only", "Silent"] : ["Сигнал и голос", "Только сигнал", "Только голос", "Тишина"]; current-index <=> root.audio-index; selected => { root.edited(); } } }
                    Field { title: root.english ? "Audio output" : "Устройство озвучки"; ComboBox { model: root.audio-device-names; current-index <=> root.audio-device-index; accessible-label: parent.title; selected => { root.audio-device-id=root.audio-device-ids[root.audio-device-index]; root.edited(); } } }
                    HorizontalLayout { spacing: 8px; Button { text: root.english ? "Refresh outputs" : "Обновить устройства"; clicked => { root.refresh-audio(); } } Button { text: root.english ? "Chime" : "Сигнал"; clicked => { root.test-audio(0); } } Button { text: root.english ? "Voice" : "Голос"; clicked => { root.test-audio(1); } } Button { text: root.english ? "Stop" : "Стоп"; clicked => { root.silence(); } } }
                    Label { height: 55px; wrap: word-wrap; text: root.audio-test-status; color: Colors.muted; }
                    CheckBox { text: root.english ? "Allow reminders during Windows restrictions" : "Напоминать при ограничении Windows"; checked <=> root.allow-during-dnd; toggled => { root.edited(); } }
                    Label { height: 110px; wrap: word-wrap; color: Colors.muted; text: root.english ? "Windows does not reliably expose its Do not disturb switch to this app. Reported restrictions are respected, but automatic DND integration is limited. Use Pause for guaranteed silence. This exception never bypasses screen lock, pause or fullscreen settings." : "Windows не всегда передаёт приложению состояние «Не беспокоить». Полученные ограничения учитываются, но точное следование DND не гарантируется. Для тишины используй паузу. Исключение не отменяет блокировку, паузу и настройки полного экрана."; }
                    Field { title: root.english ? "Over fullscreen apps" : "Поверх полного экрана"; ComboBox { accessible-label: parent.title; model: root.english ? ["Companion and message", "Message only", "Nothing"] : ["Маскот с сообщением", "Только сообщение", "Ничего"]; current-index <=> root.fullscreen-visual-index; selected => { root.edited(); } } }
                    Field { title: root.english ? "Fullscreen audio" : "Звук при полном экране"; ComboBox { accessible-label: parent.title; model: root.english ? ["Chime and voice", "Chime only", "Voice only", "Silent"] : ["Сигнал и голос", "Только сигнал", "Только голос", "Тишина"]; current-index <=> root.fullscreen-audio-index; selected => { root.edited(); } } }
                    CheckBox { text: root.english ? "Show companion" : "Показывать маскота"; checked <=> root.pet-visible; toggled => { root.edited(); } }
                    CheckBox { text: root.english ? "Occasional companion animations" : "Редкие движения маскота"; checked <=> root.animation; toggled => { root.edited(); } }
                    Field { title: root.english ? "Animation intensity" : "Интенсивность анимации"; ComboBox { model: root.english ? ["Off", "Subtle", "Expressive"] : ["Без движения", "Сдержанно", "Выразительно"]; current-index <=> root.animation-index; accessible-label: parent.title; selected => { root.edited(); } } }
                    Label { height: 58px; wrap: word-wrap; color: Colors.muted; text: root.english ? "Animations stop on battery, while paused, and when Windows disables animations. The rule also applies to GIFs and atlases." : "Движения останавливаются от батареи, на паузе и при отключении анимаций Windows. Правило действует и для GIF, и для атласов."; }

                }
            }
            if root.page == 6 : Card { vertical-stretch: 0; VerticalLayout { padding: 24px; spacing: 14px;
                    Label { text: root.english ? "Preview storage" : "Хранилище этой версии"; height: 28px; font-weight: 600; }
                    LineEdit { text: root.storage-path; read-only: true; height: 46px; accessible-label: root.english ? "Storage path, read only, select to copy" : "Путь хранилища, только чтение, можно скопировать"; }
                    Field { title: root.english ? "Recovery storage limit · MB" : "Лимит резервов и карантина · МБ"; SpinBox { accessible-label: parent.title; minimum: 100; maximum: 100000; value <=> root.recovery-limit-mb; edited => { root.edited(); } } }
                    Label { height: 60px; wrap: word-wrap; color: Colors.muted; text: root.english ? "Storage is independent of the program version. Profile archives exclude model weights and runtimes. Reminders continue during archive preparation." : "Хранилище не зависит от версии программы. Профильный архив не включает веса моделей и среды. Во время подготовки архива напоминания продолжаются."; }
                    Field { title:root.english ? "Data operation" : "Операция с данными"; ComboBox {model:root.english ? ["Export profile","Restore profile","Move shared storage"] : ["Экспорт профиля","Восстановление профиля","Перенос общей папки"];current-index <=> root.profile-operation-index;enabled:!root.profile-running && !root.transfer-busy;accessible-label:parent.title;selected=>{root.profile-action(5);root.transfer-cancel();}} }
                    if root.profile-operation-index==0 : VerticalLayout {spacing:12px;
                    Label { text: root.english ? "Export profile" : "Экспорт профиля";height:32px;font-weight:600; }
                    CheckBox {text:root.english ? "Include phrase library and history" : "Включить библиотеку и историю";checked <=> root.profile-include-library;enabled:!root.profile-running;toggled => {root.profile-action(5);} }
                    CheckBox {text:root.english ? "Include generated recordings" : "Включить сгенерированные записи";checked <=> root.profile-include-audio;enabled:!root.profile-running && root.profile-include-library;toggled => {root.profile-action(5);} }
                    Label {height:60px;wrap:word-wrap;color:Colors.muted;text:root.english ? "Settings, character and voice/visual presets with their own references are included. Backups, quarantine, code, models and private logs are excluded." : "Настройки и пресеты характера, голоса и внешности с их референсами включены. Резервы, карантин, код, модели и частные логи исключены.";}
                    LineEdit {text <=> root.profile-export-path;accessible-label:root.english ? "New profile ZIP path" : "Путь нового ZIP профиля";enabled:!root.profile-running;}
                    HorizontalLayout {spacing:8px;
                        Button {text:root.english ? "Choose ZIP…" : "Выбрать ZIP…";enabled:!root.profile-running;clicked => {root.profile-browse(true);} }
                        Button {text:root.english ? "Estimate" : "Рассчитать";enabled:!root.profile-running && !root.dirty;clicked => {root.profile-action(0);} }
                        Button {text:root.english ? "Export" : "Экспортировать";enabled:!root.profile-running && !root.dirty && root.profile-review=="export";clicked => {root.profile-action(1);} }
                    }
                    }
                    if root.profile-operation-index==1 : VerticalLayout {spacing:12px;
                    Label {text:root.english ? "Restore profile" : "Восстановление профиля";height:32px;font-weight:600;}
                    LineEdit {text <=> root.profile-import-path;accessible-label:root.english ? "Profile ZIP to restore" : "ZIP профиля для восстановления";enabled:!root.profile-running;}
                    HorizontalLayout {spacing:8px;
                        Button {text:root.english ? "Open ZIP…" : "Открыть ZIP…";enabled:!root.profile-running;clicked => {root.profile-browse(false);} }
                        Button {text:root.english ? "Inspect archive" : "Проверить архив";enabled:!root.profile-running && !root.dirty;clicked => {root.profile-action(2);} }
                    }
                    }
                    if root.profile-operation-index<2 : VerticalLayout {spacing:12px;
                    TextEdit {height:180px;read-only:true;text:root.english ? root.profile-summary-en : root.profile-summary-ru;accessible-label:root.english ? "Profile operation summary and conflicts" : "Сводка операции и конфликтов";}
                    HorizontalLayout {spacing:8px;
                        if root.profile-operation-index==1 : Button {text:root.english ? "Apply restore" : "Применить восстановление";primary:true;enabled:root.profile-can-apply && !root.profile-running && !root.dirty;clicked => {root.profile-action(3);} }
                        Button {text:root.english ? "Cancel" : "Отменить";enabled:root.data-operation-active;clicked => {root.profile-action(4);} }
                    }
                    Label {height:95px;wrap:word-wrap;text:root.english ? root.profile-status-en : root.profile-status-ru;color:Colors.muted;}
                    LineEdit {text:root.profile-output;read-only:true;accessible-label:root.english ? "Result archive or backup path" : "Путь результата или резервной копии";}
                    }
                    if root.profile-operation-index==2 : VerticalLayout {spacing:12px;
                    Label {text:root.english ? "Move shared storage" : "Перенести общую папку";height:32px;font-weight:600;}
                    Label {height:100px;wrap:word-wrap;color:Colors.muted;text:root.english ? "Available in the installed version. All owned data, models and runtimes move together; external paths stay in place. Choose a new folder. After review, Kavychka closes for a verified copy and pointer switch. The original folder is retained." : "Доступно в установленной версии. Свои данные, модели и среды переносятся вместе; внешние пути остаются на месте. Укажи новую папку. После проверки Кавычка закроется для проверенного копирования и переключения указателя. Исходная папка сохраняется.";}
                    LineEdit {text <=> root.transfer-target;enabled:root.transfer-available && !root.transfer-busy;accessible-label:root.english ? "New shared storage folder" : "Новая общая папка";}
                    HorizontalLayout {spacing:8px;
                        Button {text:root.english ? "Review move" : "Проверить перенос";enabled:root.transfer-available && !root.transfer-busy && !root.data-operation-active && !root.update-running && !root.dirty;clicked=>{root.transfer-estimate();}}
                        Button {text:root.english ? "Move and restart" : "Перенести и перезапустить";enabled:root.transfer-reviewed && !root.transfer-busy && !root.data-operation-active && !root.update-running && !root.dirty;clicked=>{root.transfer-apply();}}
                        Button {text:root.english ? "Cancel" : "Отменить";enabled:root.transfer-busy || root.transfer-reviewed;clicked=>{root.transfer-cancel();}}
                    }
                    TextEdit {height:180px;text:root.transfer-status;read-only:true;accessible-label:root.english ? "Storage move summary" : "Сводка переноса хранилища";}
                    }
            } }
            if root.page == 7 : Card { vertical-stretch: 0; VerticalLayout { padding: 24px; spacing: 14px;
                    Label { text: root.english ? "App updates" : "Обновления приложения"; height: 28px; font-size: 18px; font-weight: 600; }
                    Label { text: (root.english ? "Version " : "Версия ") + root.app-version; height: 20px; color: Colors.muted; }
                    Label { text: root.update-status; height: 55px; wrap: word-wrap; color: Colors.muted; }
                    TextEdit { read-only: true; text: root.update-notes; height: 70px; accessible-label: root.english ? "Release notes" : "Описание обновления"; }
                    if root.update-available : Label { min-height: 72px; vertical-stretch: 0; wrap: word-wrap; color: Colors.muted; text: root.english ? "Kavychka " + root.app-version + " → " + root.update-version + ". Only the application is updated. Settings and the library are backed up before activation; models and voice references stay in place. Background generation will stop when you restart. You can roll back the last update." : "Кавычка " + root.app-version + " → " + root.update-version + ". Обновляется программа. Перед переходом сохраняется резерв настроек и библиотеки; модели и голосовые референсы остаются на месте. При перезапуске фоновая генерация остановится. Последнее обновление можно откатить."; }
                    HorizontalLayout { spacing: 8px; Button { text: root.english ? "Check" : "Проверить"; enabled: root.installed-version && !root.update-running; clicked => { root.check-updates(); } } Button { text: root.english ? "Download" : "Скачать"; enabled: root.update-available && !root.update-running; clicked => { root.download-update(); } } Button { text: root.english ? "Cancel download" : "Отменить загрузку"; enabled: root.update-running; clicked => { root.cancel-update(); } } }
                    HorizontalLayout { spacing: 8px; Button { text: root.english ? "Restart and update" : "Перезапустить и обновить"; enabled: root.update-downloaded && !root.dirty && !root.busy && !root.data-operation-active && !root.profile-running && !root.transfer-busy && !root.update-running; clicked => { root.apply-update(); } } Button { text: root.english ? "Roll back last update" : "Откатить последнее обновление"; enabled: root.rollback-available && !root.dirty && !root.busy && !root.data-operation-active && !root.profile-running && !root.transfer-busy && !root.update-running; clicked => { root.rollback-update(); } } }
                    Label { text: root.english ? "Save settings before restarting. Rollback retains new work separately; model weights stay in place." : "Перед перезапуском сохрани настройки. Откат сохраняет новые данные отдельно; веса моделей остаются на месте."; height: 40px; wrap: word-wrap; color: Colors.muted; }
                    Label { height: 65px; wrap: word-wrap; color: Colors.muted; text: root.english ? "Closing the window leaves reminders in the tray. To stop them, choose Exit. Local models are optional: built-in reminders and system speech work offline." : "Закрытие окна оставляет напоминания в трее. Чтобы завершить работу, выбери «Выйти». Локальные модели необязательны: встроенные фразы и системный голос работают офлайн."; }
                    AboutSlint { height: 100px; }
                    Button {text:root.english ? "Close Kavychka and review removal…" : "Закрыть Кавычку и посмотреть удаление…";enabled:root.removal-available && !root.dirty && !root.data-operation-active && !root.update-running && !root.transfer-busy;clicked=>{root.open-removal();}}
                    Label {text:root.english ? "Local diagnostics" : "Локальная диагностика";height:28px;font-size:18px;font-weight:600;}
                    HorizontalLayout {spacing:8px;
                        Button {text:root.english ? "Preview report" : "Посмотреть отчёт";enabled:!root.profile-running && !root.dirty;clicked=>{root.profile-action(6);}}
                        Button {text:root.english ? "Save report" : "Сохранить отчёт";enabled:root.profile-review=="diagnostic" && !root.profile-running;clicked=>{root.profile-action(7);}}
                        Button {text:root.english ? "Close preview" : "Закрыть просмотр";enabled:root.profile-review=="diagnostic";clicked=>{root.profile-action(4);}}
                    }
                    TextEdit {height:200px;read-only:true;text:root.profile-review=="diagnostic" ? (root.english ? root.profile-summary-en : root.profile-summary-ru) : "";accessible-label:root.english ? "Diagnostic report preview" : "Предварительный просмотр диагностики";}
                    Label {height:60px;wrap:word-wrap;text:root.english ? root.profile-status-en : root.profile-status-ru;color:Colors.muted;}
                    LineEdit {text:root.profile-output;read-only:true;accessible-label:root.english ? "Saved report path" : "Путь сохранённого отчёта";}
            } }
            if root.page == 2 : Card { vertical-stretch: 0;
                VerticalLayout { padding: 26px; spacing: 10px;
                    Label { text: root.library-summary; height: 36px; font-size: 16px; wrap: word-wrap; }
                    HorizontalLayout {height:34px;spacing:8px;
                        Button {text:root.english ? "Previous" : "Назад";enabled:root.library-page-index>0;clicked=>{root.library-page(-1);}}
                        Label {text:root.library-page-caption;}
                        Button {text:root.english ? "Next" : "Далее";enabled:root.library-has-next;clicked=>{root.library-page(1);}}
                    }
                    Label { height: 46px; wrap: word-wrap; color: Colors.muted; text: root.english ? "Prepare day follows the schedule. New batch uses the categories and total count below. Save changes before starting a task." : "«Подготовить день» учитывает расписание. «Новая партия» использует категории и общее количество ниже. Сохрани изменения перед запуском."; }
                    Field { title: root.english ? "New batch · total phrases" : "Новая партия · всего фраз"; SpinBox { minimum: 1; maximum: 100; value <=> root.batch-count; accessible-label: parent.title; edited => { root.edited(); } } }
                    HorizontalLayout { height: 34px;
                        CheckBox { text: root.english ? "Break" : "Перерыв"; checked <=> root.category-break; toggled => { root.edited(); } }
                        CheckBox { text: root.english ? "Breakfast" : "Завтрак"; checked <=> root.category-breakfast; toggled => { root.edited(); } }
                        CheckBox { text: root.english ? "Lunch" : "Обед"; checked <=> root.category-lunch; toggled => { root.edited(); } }
                    }
                    HorizontalLayout { height: 34px;
                        CheckBox { text: root.english ? "Dinner" : "Ужин"; checked <=> root.category-dinner; toggled => { root.edited(); } }
                        CheckBox { text: root.english ? "Stretch" : "Разминка"; checked <=> root.category-exercise; toggled => { root.edited(); } }
                    }

                    HorizontalLayout { spacing: 8px;
                        Button { text: root.english ? "Prepare day" : "Подготовить день"; enabled: !root.generation-running && !root.dirty; clicked => { root.prepare-day(); } }
                        Button { text: root.english ? "Generate batch" : "Новая партия"; enabled: !root.generation-running && !root.dirty; clicked => { root.generate-batch(); } }
                        Button { text: root.english ? "Voice only · today" : "Переозвучить сегодня"; enabled: !root.generation-running; clicked => { root.regenerate-speech(""); } }
                    }
                    if root.on-battery : Button { text: root.english ? "New batch · allow battery once" : "Новая партия · от батареи один раз"; enabled: !root.generation-running && !root.dirty; clicked => { root.generate-on-battery(); } }
                    HorizontalLayout { spacing: 8px;
                        CheckBox { text: root.english ? "Today only" : "Только сегодня"; checked <=> root.library-today; toggled => { root.library-filter(); } }
                        Button { text: root.english ? "Export ZIP" : "Экспорт ZIP"; enabled: !root.generation-running; clicked => { root.export-library(); } }
                        Button { text: root.english ? "Clear recordings…" : "Очистить записи…"; enabled: !root.generation-running; clicked => { root.confirm-clear = true; } }
                        Button { text: root.english ? "Cancel task" : "Отменить задачу"; enabled: root.generation-running; clicked => { root.cancel-generation(); } }
                    }
                    Label { text: root.library-status; height: 50px; wrap: word-wrap; color: Colors.muted; font-size: 12px; }
                }
            }
            if root.page == 2 && root.confirm-clear : Card { vertical-stretch: 0;
                VerticalLayout { padding: 18px; spacing: 10px;
                    Label { text: root.english ? "Remove audio from this working library? Text history and the original installation remain. A recovery copy is kept." : "Убрать аудио из этой рабочей библиотеки? История текстов и старая установка сохранятся. Останется восстановимая копия."; wrap: word-wrap; height: 44px; }
                    HorizontalLayout { Button { text: root.english ? "Cancel" : "Отмена"; clicked => { root.confirm-clear = false; } } Button { text: root.english ? "Clear audio" : "Убрать аудио"; clicked => { root.clear-recordings(); root.confirm-clear = false; } } }
                }
            }
            if root.page == 2 : VerticalLayout { spacing: 12px;
            for row in root.library-items : Card { height: 166px;
                VerticalLayout { padding: 20px; spacing: 8px;
                    Label { text: row.caption; height: 23px; color: Colors.muted; font-size: 12px; }
                    Label { text: row.text; height: 62px; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px;
                        Button { text: root.english ? "Listen" : "Послушать"; enabled: row.has-audio; clicked => { root.play-phrase(row.identifier); } }
                        Button { text: root.english ? "Keep" : "Оставить"; enabled: !row.kept || row.excluded; clicked => { root.select-phrase(row.identifier,true); } }
                        Button { text: root.english ? "Exclude" : "Исключить"; enabled: !row.excluded; clicked => { root.select-phrase(row.identifier,false); } }
                        Button { text: root.english ? "New voice" : "Переозвучить"; enabled: !root.generation-running; clicked => { root.regenerate-speech(row.identifier); } }
                    }
                }
            }
            }
            if root.page == 3 : Card { vertical-stretch: 0;
                VerticalLayout { padding: 26px; spacing: 12px;
                    Field { title: root.english ? "Text model" : "Модель текста"; ComboBox { accessible-label: parent.title; model: root.text-catalog; current-index <=> root.text-model-index; selected => { root.edited(); } } }
                    Label { text: root.text-notes[root.text-model-index]; height: 88px; wrap: word-wrap; color: Colors.muted; font-size: 12px; }
                    Field { title: root.english ? "Voice model" : "Модель голоса"; ComboBox { accessible-label: parent.title; model: root.voice-catalog; current-index <=> root.voice-model-index; selected => { root.edited(); } } }
                    Label { text: root.voice-notes[root.voice-model-index]; height: 88px; wrap: word-wrap; color: Colors.muted; font-size: 12px; }
                    Field { title: root.english ? "Voice reference" : "Голосовой пресет"; ComboBox { accessible-label: parent.title; enabled: root.voice-model-index != 0; model: root.voice-profile-names; current-index <=> root.voice-profile-index; selected => { root.edited(); } } }
                    Field { title: root.english ? "Compute device" : "Устройство вычислений"; ComboBox { accessible-label: parent.title; model: ["Auto", "CPU", "NVIDIA CUDA"]; current-index <=> root.compute-device; selected => { root.edited(); } } }
                    CheckBox { text: root.english ? "Generate text with a local model" : "Создавать тексты локальной моделью"; checked <=> root.text-enabled; toggled => { root.edited(); } }
                    CheckBox { text: root.english ? "Runtime · new phrase at each event" : "Рантайм · новая фраза при событии"; checked <=> root.runtime-generation; toggled => { root.edited(); } }
                    Field { title: root.english ? "Runtime text model" : "Текст для рантайма"; ComboBox { accessible-label: parent.title; model: root.text-catalog; current-index <=> root.runtime-model-index; selected => { root.edited(); } } }
                    Field { title: root.english ? "Runtime wait · seconds" : "Ожидание рантайма · секунд"; SpinBox { accessible-label: parent.title; minimum: 1; maximum: 120; value <=> root.runtime-seconds; edited => { root.edited(); } } }
                    Field { title: root.english ? "Manual batch · phrases" : "Фраз в ручной партии"; SpinBox { accessible-label: parent.title; minimum: 1; maximum: 100; value <=> root.batch-count; edited => { root.edited(); } } }
                    CheckBox { text: root.english ? "Prepare missing daily phrases automatically" : "Автоматически готовить недостающие фразы на день"; checked <=> root.auto-daily; toggled => { root.edited(); } }
                    CheckBox { text: root.english ? "Keep new daily phrases automatically" : "Автоматически оставлять новые фразы"; checked <=> root.auto-keep; toggled => { root.edited(); } }
                    CheckBox { text: root.english ? "Background generation on AC power only" : "Фоновая генерация только от сети"; checked <=> root.generation-ac-only; toggled => { root.edited(); } }
                    Label { text: root.english ? "Only selected models are downloaded. Existing weights and runtimes are reused. Additional environment space: voice CUDA up to 7 GB, CPU 2 GB; CosyVoice 0.7 GB; text CUDA up to 1.5 GB." : "Скачиваются только выбранные модели. Готовые веса и среды используются повторно. Дополнительно для среды: голос CUDA до 7 ГБ, CPU 2 ГБ; CosyVoice 0,7 ГБ; текст CUDA до 1,5 ГБ."; height: 70px; wrap: word-wrap; color: Colors.muted; font-size: 12px; }
                    HorizontalLayout { Button { text: root.english ? "Install or verify selected" : "Установить или проверить выбранные"; enabled: !root.generation-running; clicked => { root.install-models(); } } Button { text: root.english ? "Cancel" : "Отменить"; enabled: root.generation-running; clicked => { root.cancel-generation(); } } }
                    Label { text: root.library-status; height: 50px; wrap: word-wrap; color: Colors.muted; font-size: 12px; }
                }
            }
            if root.page == 3 : Card { vertical-stretch: 0;
                VerticalLayout { padding: 20px; spacing: 12px;
                    CheckBox { text: root.english ? "Advanced · use an existing model folder" : "Дополнительно · готовая папка модели"; checked <=> root.model-advanced; }
                    if root.model-advanced : Field { title: root.english ? "Model" : "Модель"; ComboBox { model: root.path-model-names; current-index <=> root.path-model-index; accessible-label: parent.title; selected => { root.path-selected(); } } }
                    if root.model-advanced : Field { title: root.english ? "Absolute folder · blank = automatic" : "Абсолютный путь · пусто = авто"; LineEdit { text <=> root.path-model-value; accessible-label: parent.title; edited => { root.path-edited(); root.edited(); } } }
                    if root.model-advanced : Label { height: 72px; wrap: word-wrap; color: Colors.muted; text: root.english ? "Changes apply only to the selected model. Other model paths are preserved. This field does not copy or download files. Use the model directory expected by that backend." : "Меняется путь только выбранной модели. Остальные пути сохраняются. Поле не копирует и не скачивает файлы. Укажи папку модели, которую ожидает её движок."; }
                    if root.model-advanced : Label {height:65px;wrap:word-wrap;color:Colors.muted;text:root.english ? "Environment repair reinstalls service components for the selected models in managed storage. It can download runtime files again; external environments are retained. Export a profile before maintenance." : "Восстановление переустанавливает служебные компоненты выбранных моделей в управляемой папке. Файлы среды могут скачаться повторно; внешняя среда сохраняется. Перед обслуживанием экспортируй профиль.";}
                    if root.model-advanced : Button {text:root.english ? "Repair selected environment" : "Восстановить среду выбранных моделей";enabled:!root.generation-running && !root.dirty;clicked=>{root.repair-environment();}}
                }
            }
            if root.page == 4 : Card { vertical-stretch: 0;
                VerticalLayout { padding: 26px; spacing: 12px;
                    Label { text: root.english ? "Character · independent of voice" : "Характер · отдельно от голоса"; height: 28px; font-size: 18px; font-weight: 600; }
                    Field { title: root.english ? "Character preset" : "Пресет характера"; ComboBox { accessible-label: parent.title; model: root.character-names; current-index <=> root.character-index; selected => { root.character-selected(); root.edited(); } } }
                    TextEdit { accessible-label: root.english ? "Character description" : "Описание характера"; text <=> root.character-description; height: 185px; edited => { root.character-index = 0; root.edited(); } }
                    Field { title: root.english ? "Appearance preset" : "Пресет внешности"; ComboBox { accessible-label: parent.title; model: root.visual-names; current-index <=> root.visual-index; selected => { root.edited(); } } }
                    Field { title: root.english ? "Mascot size" : "Размер маскота"; SpinBox { accessible-label: parent.title; minimum: 80; maximum: 260; value <=> root.pet-size; edited => { root.edited(); } } }
                    CheckBox { text: root.english ? "Allow swearing" : "Разрешить мат"; checked <=> root.swear; toggled => { root.edited(); } }
                    Field { title: root.english ? "Delivery" : "Подача"; ComboBox { accessible-label: parent.title; model: root.delivery-names; current-index <=> root.delivery-index; selected => { root.edited(); } } }
                    if root.delivery-index == 1 : LineEdit { accessible-label: root.english ? "Custom acting instruction" : "Своя инструкция подачи"; text <=> root.custom-instruction; placeholder-text: root.english ? "Acting instruction" : "Инструкция актёру"; edited => { root.edited(); } }
                    Label { text: root.english ? "CosyVoice supports acting instructions; Qwen Base uses its reference voice. Auto avoids repeating the same delivery." : "CosyVoice поддерживает инструкции интонации; Qwen Base использует голос референса. Авто старается чередовать подачи."; height: 48px; wrap: word-wrap; color: Colors.muted; font-size: 12px; }
                    LineEdit { text <=> root.delivery-name; placeholder-text: root.english ? "New delivery name" : "Название новой подачи"; }
                    LineEdit { text <=> root.delivery-instruction; placeholder-text: root.english ? "Acting instruction in English" : "Инструкция актёру на английском"; }
                    HorizontalLayout { Button { text: root.english ? "Add delivery" : "Добавить подачу"; clicked => { root.add-delivery(); } } Button { text: root.english ? "Remove selected" : "Удалить выбранную"; enabled: root.delivery-index >= 2; clicked => { root.remove-delivery(); } } }
                    Label { text: root.english ? "Personal references and imported character settings stay in local storage and are not published with the application." : "Личные референсы и перенесённые настройки персонажа хранятся локально и не публикуются с приложением."; height: 50px; wrap: word-wrap; color: Colors.muted; font-size: 12px; }
                    Label { text: root.english ? "Manage independent presets" : "Управление отдельными пресетами"; height: 28px; font-size: 18px; font-weight: 600; }
                    ComboBox { accessible-label: root.english ? "Import type" : "Тип импорта"; model: root.english ? ["Character", "Voice", "Appearance"] : ["Характер", "Голос", "Внешность"]; current-index <=> root.import-kind; }
                    Label { text: root.english ? "Import .kavychka / preset.json, TXT, image, or audio. Voice: 1–30 seconds of clean speech, at least 16 kHz; transcript should match. Images: up to 40M pixels. GIF: up to 300 frames and 40M decoded pixels in total. Codex atlas: 1536 × 1872. Files up to 200 MiB. Audio is converted locally when a compatible media runtime is installed." : "Импорт .kavychka / preset.json, TXT, картинки или звука. Голос: 1–30 секунд чистой речи, от 16 кГц; расшифровка должна совпадать. Картинка: до 40 млн пикселей. GIF: до 300 кадров и суммарно 40 млн декодированных пикселей. Атлас Codex: 1536 × 1872. До 200 МиБ. Звук преобразуется локально при установленной совместимой среде медиа."; height: 120px; wrap: word-wrap; color: Colors.muted; font-size: 12px; }
                    HorizontalLayout { spacing: 8px; LineEdit { accessible-label: root.english ? "File to import" : "Файл для импорта"; text <=> root.import-path; placeholder-text: root.english ? "Local file" : "Локальный файл"; } Button { text: "…"; accessible-label: root.english ? "Choose preset or media file" : "Выбрать файл пресета или медиа"; clicked => { root.choose-preset-file(); } } Button { text: root.english ? "Import" : "Импорт"; clicked => { root.import-preset(); } } }
                    if root.import-kind == 1 : Field { title: root.english ? "Transcript for imported audio · optional" : "Расшифровка импортируемого голоса · необязательно"; TextEdit { accessible-label: parent.title; text <=> root.import-transcript; height: 80px; } }
                    Field { title: root.english ? "Edit preset · new character" : "Редактировать пресет · новый характер"; ComboBox { accessible-label: parent.title; model: root.preset-names; current-index <=> root.preset-index; selected => { root.preset-selected(); } } }
                    LineEdit { accessible-label: root.english ? "Preset name" : "Название пресета"; text <=> root.preset-name; placeholder-text: root.english ? "Preset name" : "Название пресета"; }
                    ComboBox { accessible-label: root.english ? "Voice reference" : "Голосовой референс"; model: root.reference-names; current-index <=> root.reference-index; selected => { root.reference-selected(); } }
                    TextEdit { accessible-label: root.english ? "Preset content" : "Содержимое пресета"; text <=> root.preset-body; height: 130px; }
                    ComboBox { accessible-label: root.english ? "Appearance layout" : "Формат внешности"; model: ["Auto", "Image", "Codex 1536 × 1872"]; current-index <=> root.visual-layout; }
                    HorizontalLayout { spacing: 10px; Button { text: root.english ? "Save preset" : "Сохранить пресет"; clicked => { root.save-preset(); } } Button { enabled: root.preset-index > 0; text: root.english ? "Export preset" : "Экспорт пресета"; clicked => { root.export-preset(); } } Button { enabled: root.preset-index > 0; text: root.english ? "Delete…" : "Удалить…"; clicked => { root.confirm-preset-delete = true; } } }
                    if root.confirm-preset-delete : HorizontalLayout { Label { text: root.english ? "Delete this preset?" : "Удалить этот пресет?"; } Button { text: root.english ? "Delete" : "Удалить"; clicked => { root.delete-preset(); root.confirm-preset-delete = false; } } Button { text: root.english ? "Cancel" : "Отмена"; clicked => { root.confirm-preset-delete = false; } } }
                }
            }
        }
    }
    Label { x: root.content-x; y: parent.height - 103px; width: root.content-width; height: 40px; wrap: word-wrap; font-size: 12px; color: root.failed ? (Colors.dark ? #ffaaa3 : #aa2727) : Colors.muted;
        text: root.status != "" ? root.status : root.dirty ? (root.english ? "Unsaved changes" : "Есть несохранённые изменения") : root.ready ? (root.english ? "Settings loaded" : "Настройки загружены") : (root.english ? "Opening storage…" : "Открываем хранилище…");
    }
    HorizontalLayout { x: root.content-x; y: parent.height - 55px; width: root.content-width; height: 34px; spacing: 12px;
        Rectangle { horizontal-stretch: 1; }
        Button { text: root.english ? "Discard changes" : "Отменить изменения"; enabled: root.ready && root.dirty && !root.busy && !root.confirm-close && !root.onboarding; clicked => { root.discard(); } }
        Button { text: root.busy ? (root.english ? "Saving…" : "Сохраняем…") : (root.english ? "Save settings" : "Сохранить настройки"); primary: true; enabled: root.ready && root.dirty && !root.busy && !root.confirm-close && !root.onboarding; clicked => { root.save(); } }
    }
    if root.onboarding && root.ready : Rectangle {
        width: root.width; height: root.height; background: Colors.canvas;
        VerticalLayout { padding: root.compact ? 24px : 40px; spacing: 14px;
            Label { height: 38px; font-size: 26px; font-weight: 600; text: root.english ? "Welcome to Kavychka" : "Привет, я Кавычка"; }
            Label { height: 26px; color: Colors.muted; text: (root.setup-step + 1) + " / 4 · " + (root.setup-step == 0 ? (root.english ? "Language and name" : "Язык и имя") : root.setup-step == 1 ? (root.english ? "Your schedule" : "Твоё расписание") : root.setup-step == 2 ? (root.english ? "Try a reminder" : "Проверка напоминания") : (root.english ? "Optional models" : "Модели — по желанию")); }
            ScrollView { content-width: self.width; VerticalLayout { spacing: 12px;
                if root.setup-step == 0 : VerticalLayout { spacing: 12px;
                    Field { title: root.english ? "Interface" : "Интерфейс"; ComboBox { model: ["Русский", "English"]; current-index <=> root.language-index; accessible-label: parent.title; selected => { root.edited(); } } }
                    Field { title: root.english ? "Speech" : "Озвучка"; ComboBox { model: ["Русский", "English"]; current-index <=> root.speech-index; accessible-label: parent.title; selected => { root.edited(); } } }
                    Field { title: root.english ? "Your name · optional" : "Твоё имя · необязательно"; LineEdit { text <=> root.user-name; accessible-label: parent.title; edited => { root.edited(); } } }
                    Field { title: root.english ? "Address me as" : "Обращаться ко мне"; ComboBox { model: root.english ? ["Neutral", "Feminine", "Masculine"] : ["Нейтрально", "В женском роде", "В мужском роде"]; current-index <=> root.address-index; accessible-label: parent.title; selected => { root.edited(); } } }
                    Label {height:50px;wrap:word-wrap;color:Colors.muted;text:root.english ? "Have a profile archive? Inspect it first, then explicitly restore settings, presets and your library on this clean installation." : "Есть архив профиля? Сначала проверь его, затем явно восстанови настройки, пресеты и библиотеку на этой чистой установке.";}
                    Button {text:root.english ? "Open profile archive…" : "Открыть архив профиля…";enabled:!root.profile-running;clicked => {root.profile-browse(false);} }
                    if root.profile-review=="restore" : TextEdit {height:200px;read-only:true;text:root.english ? root.profile-summary-en : root.profile-summary-ru;accessible-label:root.english ? "Restore summary" : "Сводка восстановления";}
                    if root.data-operation-active : HorizontalLayout {spacing:8px;
                        Button {text:root.english ? "Apply restore" : "Применить восстановление";primary:true;enabled:root.profile-can-apply && !root.profile-running;clicked => {root.profile-action(3);} }
                        Button {text:root.english ? "Cancel" : "Отменить";clicked => {root.profile-action(4);} }
                    }
                    Label {height:90px;wrap:word-wrap;color:Colors.muted;text:root.english ? root.profile-status-en : root.profile-status-ru;}
                }
                if root.setup-step == 1 : VerticalLayout { spacing: 12px;
                    Label { height: 32px; text: root.english ? "Reminder days" : "Дни напоминаний"; }
                    HorizontalLayout { height: 36px;
                        CheckBox { text: root.english ? "Mo" : "Пн"; checked <=> root.monday; toggled => { root.edited(); } }
                        CheckBox { text: root.english ? "Tu" : "Вт"; checked <=> root.tuesday; toggled => { root.edited(); } }
                        CheckBox { text: root.english ? "We" : "Ср"; checked <=> root.wednesday; toggled => { root.edited(); } }
                        CheckBox { text: root.english ? "Th" : "Чт"; checked <=> root.thursday; toggled => { root.edited(); } }
                        CheckBox { text: root.english ? "Fr" : "Пт"; checked <=> root.friday; toggled => { root.edited(); } }
                        CheckBox { text: root.english ? "Sa" : "Сб"; checked <=> root.saturday; toggled => { root.edited(); } }
                        CheckBox { text: root.english ? "Su" : "Вс"; checked <=> root.sunday; toggled => { root.edited(); } }
                    }
                    Field { title: root.english ? "Work starts · HH:MM" : "Начало работы · ЧЧ:ММ"; LineEdit { text <=> root.start-time; accessible-label: parent.title; edited => { root.edited(); } } }
                    Field { title: root.english ? "Work ends · HH:MM" : "Конец работы · ЧЧ:ММ"; LineEdit { text <=> root.end-time; accessible-label: parent.title; edited => { root.edited(); } } }
                    Field { title: root.english ? "Break interval · minutes" : "Перерыв каждые · минут"; SpinBox { accessible-label: parent.title; minimum: 5; maximum: 720; value <=> root.break-minutes; edited => { root.edited(); } } }
                    CheckBox { text: root.english ? "Meal reminders" : "Напоминания о еде"; checked <=> root.meals; toggled => { root.edited(); } }
                    Field { title: root.english ? "Breakfast · HH:MM" : "Завтрак · ЧЧ:ММ"; LineEdit { accessible-label: parent.title; text <=> root.breakfast; edited => { root.edited(); } } }
                    Field { title: root.english ? "Lunch · HH:MM" : "Обед · ЧЧ:ММ"; LineEdit { accessible-label: parent.title; text <=> root.lunch; edited => { root.edited(); } } }
                    Field { title: root.english ? "Dinner · HH:MM" : "Ужин · ЧЧ:ММ"; LineEdit { accessible-label: parent.title; text <=> root.dinner; edited => { root.edited(); } } }
                    CheckBox { text: root.english ? "Stretch after breakfast, including weekends" : "Разминка после завтрака, включая выходные"; checked <=> root.stretch; toggled => { root.edited(); } }
                    Field { title: root.english ? "Stretch delay · minutes" : "Разминка через · минут"; SpinBox { accessible-label: parent.title; minimum: 1; maximum: 1440; value <=> root.stretch-minutes; edited => { root.edited(); } } }
                }
                if root.setup-step == 2 : VerticalLayout { spacing: 12px;
                    Label { height: 70px; wrap: word-wrap; text: root.english ? "Take a little break. Stand up and stretch. This is a preview: it does not confirm breakfast or start a timer." : "Сделай небольшую паузу. Встань и потянись. Это пример: он не отмечает завтрак и не запускает таймер."; }
                    Field { title: root.english ? "Audio output" : "Устройство озвучки"; ComboBox { model: root.audio-device-names; current-index <=> root.audio-device-index; accessible-label: parent.title; selected => { root.audio-device-id=root.audio-device-ids[root.audio-device-index]; root.edited(); } } }
                    HorizontalLayout { spacing: 8px; Button { text: root.english ? "Refresh outputs" : "Обновить устройства"; clicked => { root.refresh-audio(); } } Button { text: root.english ? "Chime" : "Сигнал"; clicked => { root.test-audio(0); } } Button { text: root.english ? "Voice" : "Голос"; clicked => { root.test-audio(1); } } Button { text: root.english ? "Stop" : "Стоп"; clicked => { root.silence(); } } }
                    Label { height: 55px; wrap: word-wrap; text: root.audio-test-status; color: Colors.muted; }

                    Label { height: 60px; wrap: word-wrap; color: Colors.muted; text: root.english ? "If a pinned output disappears, speech stops. Kavychka will not move it to another output. Voice preview uses an installed Windows voice." : "Если закреплённое устройство исчезнет, речь остановится без перехода на другое. Для пробы используется установленный голос Windows."; }
                }
                if root.setup-step == 3 : VerticalLayout { spacing: 18px;
                    Label { height: 100px; wrap: word-wrap; color: Colors.muted; text: root.english ? "Do not disturb: Windows does not reliably expose its switch to this app. Use Pause when you need guaranteed silence. Reported notification restrictions are respected by default." : "«Не беспокоить»: Windows не всегда передаёт приложению этот переключатель. Если нужна тишина, включай паузу. Полученные от Windows запреты учитываются по умолчанию."; }
                    Label { height: 120px; wrap: word-wrap; text: root.english ? "You can start without downloads. Built-in phrases, reminders and Windows speech already work offline. Local text and voice models are optional; choose them later and install only what you need." : "Можно начать без загрузок. Встроенные фразы, напоминания и голос Windows уже работают офлайн. Модели текста и голоса необязательны: выбери их позже и установи только нужные."; }
                    Label { height: 80px; wrap: word-wrap; color: Colors.muted; text: root.english ? "Closing settings leaves Kavychka in the tray. Exit ends reminders. All settings can be changed later." : "Закрытие настроек оставляет Кавычку в трее. «Выйти» завершает напоминания. Все настройки можно изменить позже."; }
                }
            } }
            Label { height: 42px; wrap: word-wrap; text: root.status; color: root.failed ? (Colors.dark ? #ffaaa3 : #aa2727) : Colors.muted; }
            HorizontalLayout { height: 36px; spacing: 12px;
                Button { text: root.english ? "Back" : "Назад"; enabled: root.setup-step > 0 && !root.busy; clicked => { root.setup-next(-1); } }
                Rectangle { horizontal-stretch: 1; }
                if root.setup-step < 3 : Button { text: root.english ? "Next" : "Далее"; primary: true; enabled: !root.busy && !root.data-operation-active; clicked => { root.setup-next(1); } }
                if root.setup-step == 3 : Button { text: root.english ? "Choose models" : "Выбрать модели"; enabled: !root.busy; clicked => { root.finish-setup(true); } }
                if root.setup-step == 3 : Button { text: root.english ? "Start without downloads" : "Начать без загрузок"; primary: true; enabled: !root.busy; clicked => { root.finish-setup(false); } }
            }
        }
    }
    unsaved-popup := PopupWindow {
        x: 0px; y: 0px; width: root.width; height: root.height; close-policy: no-auto-close;
        CloseDialog {
            width: root.width; height: root.height; english: root.english; background-close: root.close-to-background;
            cancel => { root.confirm-close=false; }
            discard => { root.discard-and-quit(); }
            save => { root.save-and-quit(); }
        }
    }
}
