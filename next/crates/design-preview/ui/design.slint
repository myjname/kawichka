export { ReviewWindow, ReviewRow } from "review.slint";
export global Palette {
    in property <bool> dark: false;
    out property <color> canvas: dark ? #15171d : #f5f6fa;
    out property <color> surface: dark ? #20232c : #ffffff;
    out property <color> soft: dark ? #282d3a : #edf0fc;
    out property <color> line: dark ? #333744 : #e7e9f0;
    out property <color> ink: dark ? #f1f2f6 : #242837;
    out property <color> muted: dark ? #a4adbf : #667085;
    out property <color> accent: dark ? #a1b0ff : #4d60bd;
    out property <color> button: dark ? #7488e6 : #5369c9;
}

component Label inherits Text {
    color: Palette.ink; font-family: "Segoe UI"; font-size: 14px;
    vertical-alignment: center; overflow: elide;
}
component Nav inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    width: 190px; height: 44px; border-radius: 10px;
    background: selected ? Palette.soft : transparent;
    Image { x: 16px; y: 12px; width: 20px; height: 20px; source: root.icon; colorize: root.selected ? Palette.accent : Palette.muted; }
    Label { x: 48px; width: 130px; height: parent.height; text: root.label; color: root.selected ? Palette.accent : Palette.muted; font-weight: root.selected ? 600 : 400; }
}
component Card inherits Rectangle {
    x: 0px; y: 0px;
    background: Palette.surface; border-color: Palette.line; border-width: 1px; border-radius: 16px;
}
component Primary inherits Rectangle {
    x: 0px; y: 0px;
    in property <string> label;
    background: Palette.button; border-radius: 9px; height: 40px; width: 148px;
    Label { text: root.label; color: Palette.dark ? #15171d : white; font-weight: 600; horizontal-alignment: center; }
}
component Secondary inherits Rectangle {
    x: 0px; y: 0px;
    in property <string> label;
    background: Palette.surface; border-color: Palette.line; border-width: 1px;
    border-radius: 9px; height: 40px; width: 148px;
    Label { text: root.label; color: Palette.ink; horizontal-alignment: center; }
}
component Pet inherits Rectangle {
    width: 116px; height: 116px; background: Palette.soft; border-radius: 30px;
    Image { x: 13px; y: 14px; width: 90px; height: 90px; source: @image-url("quote.svg"); }
}
component Status inherits Rectangle {
    x: 0px; y: 0px;
    in property <string> label;
    width: 110px; height: 27px; border-radius: 13px; background: Palette.soft;
    Label { text: root.label; horizontal-alignment: center; color: Palette.accent; font-size: 12px; }
}
component DayRow inherits Rectangle {
    in property <string> time;
    in property <string> title;
    in property <string> detail;
    height: 68px;
    Label { x: 22px; width: 68px; height: parent.height; text: root.time; color: Palette.muted; }
    Label { x: 104px; y: 10px; width: 290px; height: 24px; text: root.title; font-weight: 600; }
    Label { x: 104px; y: 34px; width: 480px; height: 22px; text: root.detail; color: Palette.muted; font-size: 13px; }
    Rectangle { y: parent.height - 1px; x: 22px; width: parent.width - 44px; height: 1px; background: Palette.line; }
}
component ModelRow inherits Card {
    in property <string> label;
    in property <string> model;
    in property <string> detail;
    height: 132px;
    Label { x: 24px; y: 18px; width: 350px; height: 22px; text: root.label; color: Palette.muted; font-size: 13px; }
    Label { x: 24px; y: 46px; width: 500px; height: 30px; text: root.model; font-size: 20px; font-weight: 600; }
    Label { x: 24px; y: 88px; width: 570px; height: 22px; text: root.detail; color: Palette.muted; font-size: 13px; }
    Status { x: parent.width - 138px; y: 48px; label: "Установлена"; }
    Image { x: parent.width - 170px; y: 57px; width: 16px; height: 16px; source: @image-url("chevron.svg"); colorize: Palette.muted; }
}

export component DesignWindow inherits Window {
    in property <int> page: 0;
    title: "Кавычка · макет"; width: 1100px; height: 780px;
    background: Palette.canvas;
    Rectangle {
        x: 0px; y: 0px; width: 224px; height: parent.height; background: Palette.surface;
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Palette.line; }
        Rectangle { x: 25px; y: 30px; width: 35px; height: 35px; background: Palette.button; border-radius: 10px;
            Image { x: 4px; y: 4px; width: 27px; height: 27px; source: @image-url("quote.svg"); colorize: white; }
        }
        Label { x: 72px; y: 30px; width: 134px; height: 35px; text: "Кавычка"; font-size: 20px; font-weight: 650; }
        Label { x: 26px; y: 81px; width: 180px; height: 22px; text: "Маленькие ритуалы"; font-size: 12px; color: Palette.muted; }
        VerticalLayout { x: 17px; y: 139px; width: 190px; height: 305px; spacing: 6px;
            Nav { label: "Сегодня"; icon: @image-url("clock.svg"); selected: root.page == 0; }
            Nav { label: "Расписание"; icon: @image-url("calendar.svg"); }
            Nav { label: "Библиотека"; icon: @image-url("library.svg"); selected: root.page == 2; }
            Nav { label: "Голос и модели"; icon: @image-url("voice.svg"); selected: root.page == 1; }
            Nav { label: "Персонаж"; icon: @image-url("person.svg"); }
            Nav { label: "Настройки"; icon: @image-url("settings.svg"); }
        }
        Label { x: 27px; y: parent.height - 80px; width: 170px; height: 25px; text: "●  Напоминания включены"; color: Palette.accent; font-size: 11px; }
        Label { x: 27px; y: parent.height - 50px; width: 170px; height: 25px; text: "Макет · данные для примера"; color: Palette.muted; font-size: 10px; }
    }
    Label { x: 264px; y: 30px; width: 420px; height: 25px; text: "Пятница, 23 октября"; color: Palette.muted; font-size: 13px; }
    Status { x: 935px; y: 30px; label: "Всё готово"; }
    Label { x: 264px; y: 85px; width: 770px; height: 43px; text: root.page == 0 ? "Сегодня можно чуть спокойнее." : root.page == 1 ? "Голос и модели" : "Библиотека фраз"; font-size: 28px; font-weight: 650; }
    Label { x: 264px; y: 135px; width: 780px; height: 26px; text: root.page == 0 ? "Перерывы, обед и немного внимания к себе — остальное я напомню." : root.page == 1 ? "Выбери текст и голос. Готовые модели скачивать заново не нужно." : "Послушай, выбери понравившееся. Тексты помнят, что уже звучало."; color: Palette.muted; font-size: 13px; }

    if root.page == 0 : Rectangle {
        x: 264px; y: 187px; width: 790px; height: 535px;
        Card { width: parent.width; height: 218px;
            Pet { x: 26px; y: 32px; }
            Label { x: 169px; y: 25px; width: 540px; height: 24px; text: "Ближайшее напоминание"; color: Palette.muted; font-size: 12px; }
            Label { x: 169px; y: 56px; width: 500px; height: 35px; text: "13:00 · Обед и перерыв"; font-size: 23px; font-weight: 600; }
            Label { x: 169px; y: 100px; width: 560px; height: 27px; text: "Отложи дела. У обеда тоже есть право на твоё внимание."; font-size: 13px; }
            Primary { x: 169px; y: 151px; label: "Отметить обед"; }
            Secondary { x: 331px; y: 151px; label: "Пауза на час"; }
        }
        Label { x: 0px; y: 246px; width: 500px; height: 29px; text: "Дальше по плану"; font-size: 18px; font-weight: 600; }
        Label { x: 630px; y: 246px; width: 160px; height: 29px; text: "Изменить расписание"; color: Palette.accent; font-size: 12px; }
        Card { y: 291px; width: parent.width; height: 205px;
            VerticalLayout { spacing: 0px; padding: 0px;
                DayRow { time: "14:00"; title: "Немного размяться"; detail: "Таймер после завтрака · отдельное напоминание"; }
                DayRow { time: "15:00"; title: "Перерыв от работы"; detail: "Отдых засчитается по мыши и клавиатуре"; }
                DayRow { time: "18:30"; title: "Время ужина"; detail: "Сообщение, сигнал и голос"; }
            }
        }
    }
    if root.page == 1 : Rectangle {
        x: 264px; y: 187px; width: 790px; height: 535px;
        ModelRow { width: parent.width; label: "Текст"; model: "Gemma 4 12B"; detail: "Персонаж и разнообразие фраз · локальная генерация"; }
        ModelRow { y: 148px; width: parent.width; label: "Голос"; model: "CosyVoice 3"; detail: "Подача: авто · референсы и характер настраиваются отдельно"; }
        Card { y: 312px; width: parent.width; height: 124px;
            Label { x: 24px; y: 20px; width: 610px; height: 26px; text: "Готовить фразы заранее"; font-size: 17px; font-weight: 600; }
            Label { x: 24px; y: 57px; width: 720px; height: 42px; text: "Каждый день — новые записи. В режиме создания при напоминании\nждём свежую фразу до 10 секунд, затем используем готовую."; color: Palette.muted; font-size: 13px; }
        }
        Primary { y: 465px; label: "Сохранить"; }
        Secondary { x: 162px; y: 465px; label: "Отменить"; }
    }
    if root.page == 2 : Rectangle {
        x: 264px; y: 187px; width: 790px; height: 535px;
        Status { width: 162px; label: "Сегодня · 13 готовых"; }
        Secondary { x: 566px; width: 224px; label: "Обновить только озвучку"; }
        Card { y: 63px; width: parent.width; height: 338px;
            VerticalLayout { spacing: 0px; padding: 0px;
                DayRow { time: "▶  0:04"; title: "Перерыв"; detail: "Клавиатура подождёт. Пройдись и вернись с новыми силами."; }
                DayRow { time: "▶  0:05"; title: "Обед"; detail: "У обеда тоже есть право на твоё внимание."; }
                DayRow { time: "▶  0:04"; title: "Разминка"; detail: "Давай немного движения. Хотя бы ради разнообразия."; }
                DayRow { time: "▶  0:06"; title: "Повторное напоминание"; detail: "Ты всё ещё здесь? Похоже, перерыв придётся защищать."; }
                DayRow { time: "✓"; title: "Сохранён выбор пользователя"; detail: "Прослушивание не расходует очередь напоминаний"; }
            }
        }
        Label { y: 427px; width: 790px; height: 45px; text: "Старые записи очищаются каждый день. История текстов остаётся,\nчтобы фразы не повторялись."; color: Palette.muted; font-size: 13px; }
    }
    Label { x: 264px; y: 742px; width: 790px; height: 20px; text: "Предварительный макет · кнопки и данные демонстрационные"; color: Palette.muted; font-size: 11px; }
}
